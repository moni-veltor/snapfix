# Neon (Postgres) — pooled connection used at runtime via the Neon driver adapter.
# Use the "Pooled connection" string from the Neon dashboard.
DATABASE_URL="postgres://USER:PASSWORD@ep-xxxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate` and `prisma db push`.
# Use the "Direct connection" string from the Neon dashboard.
DIRECT_URL="postgres://USER:PASSWORD@ep-xxxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Resend (invitation emails). Leave blank in dev — the server logs the accept
# link to the console and surfaces it in the UI.
RESEND_API_KEY=""
RESEND_FROM=""

# Vercel Blob (artefact uploads). Provisioned via the Vercel dashboard:
# Storage → Create → Blob → connect to project. Required for uploads.
BLOB_READ_WRITE_TOKEN=""

# The site-wide access gate uses NO env vars. The shared-secret hash
# lives in source at src/lib/access-code.ts. See
# docs/operations/access-gate.md for setup + rotation.
