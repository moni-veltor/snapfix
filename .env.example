# Neon (Postgres) — pooled connection used at runtime via the Neon driver adapter.
# Use the "Pooled connection" string from the Neon dashboard.
DATABASE_URL="postgres://USER:PASSWORD@ep-xxxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate` and `prisma db push`.
# Use the "Direct connection" string from the Neon dashboard.
DIRECT_URL="postgres://USER:PASSWORD@ep-xxxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (artefact uploads)
BLOB_READ_WRITE_TOKEN=""
