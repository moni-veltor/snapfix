// Operational Resilience Exercise Simulator — schema
// Prisma 7 (driver-adapter ready for Neon serverless on Vercel)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant: Organization + Membership (1 user → 1 org) ────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
  scenarios   Scenario[]
  exercises   Exercise[]
}

model Invitation {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        OrgRole      @default(MEMBER)
  token       String       @unique
  invitedById String?
  invitedBy   User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@unique([orgId, email])
}

// ─── Auth (NextAuth) ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Tenant membership (one user → one org)
  orgId   String?
  org     Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  orgRole OrgRole?

  accounts Account[]
  sessions Session[]

  createdScenarios       Scenario[]            @relation("ScenarioCreator")
  facilitatedExercises   Exercise[]            @relation("ExerciseFacilitator")
  exerciseParticipations ExerciseParticipant[]
  incidentLogEntries     IncidentLogEntry[]
  responses              ParticipantResponse[]
  comms                  CommunicationDraft[]
  debriefAnswers         DebriefAnswer[]
  invitationsSent        Invitation[]          @relation("InvitationInvitedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Scenario design ────────────────────────────────────────────────────────

model Scenario {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  background  String
  agenda      String?
  dDayDate    DateTime
  durationMin Int          @default(120)
  createdById String?
  createdBy   User?        @relation("ScenarioCreator", fields: [createdById], references: [id])

  ibsList              ImportantBusinessService[]
  events               Event[]
  injects              Inject[]
  facilitatorQuestions FacilitatorQuestion[]
  debriefQuestions     DebriefQuestion[]
  exercises            Exercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportantBusinessService {
  id                 String   @id @default(cuid())
  scenarioId         String
  scenario           Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  impactToleranceMin Int
  impactMetrics      String?
  criticality        String

  events   EventIBS[]
  breaches ImpactBreach[]

  @@unique([scenarioId, code])
}

model Event {
  id              String   @id @default(cuid())
  scenarioId      String
  scenario        Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  eventNo         Int
  scheduledTime   String
  isScheduled     Boolean  @default(true)
  title           String
  description     String
  expectedActions String[]
  objectives      String[]

  // Addressing — resolved per-exercise by matching ExerciseParticipant.roleTitle
  senderRoleTitle String?
  toRoleTitles    String[]
  ccRoleTitles    String[]

  ibsLinks  EventIBS[]
  injects   Inject[]
  artefacts Artefact[]
  releases  EventRelease[]
  receipts  EventReceipt[]

  createdAt DateTime @default(now())

  @@unique([scenarioId, eventNo])
}

model EventIBS {
  eventId String
  ibsId   String
  event   Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ibs     ImportantBusinessService @relation(fields: [ibsId], references: [id], onDelete: Cascade)

  @@id([eventId, ibsId])
}

model Inject {
  id            String   @id @default(cuid())
  scenarioId    String
  scenario      Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?   @relation(fields: [eventId], references: [id])
  injectNo      Int
  scheduledTime String
  isScheduled   Boolean  @default(true)
  summary       String
  description   String
  relation      String?
  payload       Json?

  // Addressing — resolved per-exercise by matching ExerciseParticipant.roleTitle
  senderRoleTitle String?
  toRoleTitles    String[]
  ccRoleTitles    String[]

  artefacts Artefact[]
  releases  InjectRelease[]
  responses ParticipantResponse[]
  receipts  InjectReceipt[]

  createdAt DateTime @default(now())

  @@unique([scenarioId, injectNo])
}

model Artefact {
  id          String   @id @default(cuid())
  eventId     String?
  injectId    String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inject      Inject?  @relation(fields: [injectId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  blobUrl     String
  contentType String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
}

model FacilitatorQuestion {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category   String
  text       String
  orderIdx   Int      @default(0)
}

model DebriefQuestion {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category   String
  text       String
  orderIdx   Int      @default(0)

  answers DebriefAnswer[]
}

// ─── Exercise lifecycle (planning → execution → debrief) ────────────────────

enum ExerciseStatus {
  PLANNING
  READY
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum ExerciseRole {
  FACILITATOR
  LEAD
  PARTICIPANT
  OBSERVER
}

model Exercise {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scenarioId    String
  scenario      Scenario     @relation(fields: [scenarioId], references: [id])
  facilitatorId String?
  facilitator   User?        @relation("ExerciseFacilitator", fields: [facilitatorId], references: [id])

  title       String
  description String?
  plannedDate DateTime?
  location    String?
  status      ExerciseStatus @default(PLANNING)

  startedAt       DateTime?
  pausedAt        DateTime?
  completedAt     DateTime?
  dDayAnchor      DateTime?
  speedMultiplier Float     @default(1.0)

  teams          ExerciseTeam[]
  participants   ExerciseParticipant[]
  eventReleases  EventRelease[]
  injectReleases InjectRelease[]
  incidentLog    IncidentLogEntry[]
  responses      ParticipantResponse[]
  comms          CommunicationDraft[]
  recoveryPlans  RecoveryPlan[]
  debriefAnswers DebriefAnswer[]
  impactBreaches ImpactBreach[]
  aar            AfterActionReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExerciseTeam {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  name        String
  description String?
  orderIdx    Int      @default(0)

  members ExerciseParticipant[]

  @@unique([exerciseId, name])
}

model ExerciseParticipant {
  id           String        @id @default(cuid())
  exerciseId   String
  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId       String?
  team         ExerciseTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roleTitle    String // e.g. "CTO", "Sn.TPM", "ISM"
  exerciseRole ExerciseRole  @default(PARTICIPANT)
  joinedAt     DateTime      @default(now())

  eventReceipts  EventReceipt[]
  injectReceipts InjectReceipt[]

  @@unique([exerciseId, userId])
}

model EventRelease {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  releasedAt  DateTime @default(now())
  triggeredBy String?

  @@unique([exerciseId, eventId])
}

model InjectRelease {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  injectId    String
  inject      Inject   @relation(fields: [injectId], references: [id], onDelete: Cascade)
  releasedAt  DateTime @default(now())
  triggeredBy String?

  @@unique([exerciseId, injectId])
}

model IncidentLogEntry {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  dDayTime   String
  kind       String
  body       String

  createdAt DateTime @default(now())
}

model ParticipantResponse {
  id              String   @id @default(cuid())
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  injectId        String
  inject          Inject   @relation(fields: [injectId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  assessment      String
  proposedActions String
  stakeholders    String?
  resources       String?
  commsNeeds      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommsAudience {
  CUSTOMER
  REGULATOR
  INTERNAL
  SENIOR_MGMT
  MEDIA
}

enum CommsStatus {
  DRAFT
  SUBMITTED
  SENT
}

model CommunicationDraft {
  id         String        @id @default(cuid())
  exerciseId String
  exercise   Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id])
  audience   CommsAudience
  subject    String
  body       String
  status     CommsStatus   @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecoveryPlan {
  id               String   @id @default(cuid())
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  priorityActions  String
  resourceAlloc    String?
  successCriteria  String?
  timelineEstimate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImpactBreach {
  id         String                   @id @default(cuid())
  exerciseId String
  exercise   Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  ibsId      String
  ibs        ImportantBusinessService @relation(fields: [ibsId], references: [id], onDelete: Cascade)
  detectedAt DateTime                 @default(now())
  dDayTime   String
  note       String?
}

model DebriefAnswer {
  id         String          @id @default(cuid())
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  questionId String
  question   DebriefQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?           @relation(fields: [authorId], references: [id])
  body       String

  createdAt DateTime @default(now())
}

model AfterActionReport {
  id         String   @id @default(cuid())
  exerciseId String   @unique
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  summary    String
  strengths  String?
  gaps       String?
  actions    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Inbox read receipts (per participant, per event/inject) ───────────────

model EventReceipt {
  id            String              @id @default(cuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participant   ExerciseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  readAt        DateTime            @default(now())

  @@unique([eventId, participantId])
}

model InjectReceipt {
  id            String              @id @default(cuid())
  injectId      String
  inject        Inject              @relation(fields: [injectId], references: [id], onDelete: Cascade)
  participantId String
  participant   ExerciseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  readAt        DateTime            @default(now())

  @@unique([injectId, participantId])
}
