  assessment      String
  proposedActions String
  stakeholders    String?
  resources       String?
  commsNeeds      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommsAudience {
  CUSTOMER
  REGULATOR
  INTERNAL
  SENIOR_MGMT
  MEDIA
}

enum CommsStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SUBMITTED
  SENT
  REJECTED
}

/// Stakeholder mapping per best practice Each stakeholder has an
/// execution owner (drafts) and an approver (signs off). Ordering rule:
/// Employees BEFORE Customers/Third-Parties; Customers WITH Third-Parties;
