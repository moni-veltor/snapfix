// Operational Resilience Exercise Simulator — schema
// Prisma 7 (driver-adapter ready for Neon serverless on Vercel)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant: Organization + Membership (1 user → 1 org) ────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum FirmTier {
  TIER_1 // Global universal / G-SIBs (HSBC, Barclays, JPM)
  TIER_2 // Digital challenger banks (Starling, Monzo, Revolut)
  TIER_3 // New banks, neobanks, EMIs, BaaS-dependent fintechs
}

model Organization {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  tier         FirmTier?
  logoBlobUrl  String?
  logoBlobPath String?
  /// Hex accent colour ("#4f46e5") — overrides the brand --accent token
  /// across the app shell. Null = default indigo.
  accentHex    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users         User[]
  invitations   Invitation[]
  scenarios     Scenario[]
  exercises     Exercise[]
  ibsRegister   OrganizationIBS[]
  actionItems   ExerciseActionItem[]
  auditLog      AuditLogEntry[]
  teamTemplates OrganizationTeamTemplate[]
  vendors       Vendor[]
  roles         OrganizationRole[]
  techSystems   TechSystem[]
  departments   Department[]
}

/// Departmental org-chart node — a business unit / team / function. Separate
/// from the IMT role catalogue (`OrganizationRole`): roles are *who sits in
/// the war-room during an exercise*; departments are *where you sit in the
/// org chart day-to-day*. An IBS can be owned end-to-end by a department;
/// a user can sit in a department. Nestable via parentId for true org-chart
/// hierarchy.
model Department {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String // "Retail Banking Technology"
  abbreviation String? // "RBT"
  description String? // 1-line purpose statement
  orderIdx    Int    @default(0)

  // Hierarchy — null parent = top-level department
  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")

  // Lead — the named director / head accountable for the department.
  leadId String?
  lead   User?   @relation("DepartmentLead", fields: [leadId], references: [id], onDelete: SetNull)

  // Members of this department.
  members User[] @relation("DepartmentMember")

  // IBSs owned end-to-end by this department.
  ownedIBS OrganizationIBS[] @relation("IBSOwnerDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

model Invitation {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        OrgRole      @default(MEMBER)
  token       String       @unique
  invitedById String?
  invitedBy   User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@unique([orgId, email])
}

// ─── Auth (NextAuth) ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Profile / contact — used for real-incident response, not just exercises.
  jobTitle        String? // "Group CRO", "Head of Tech Operations"
  location        String? // "London HQ", "Manchester ops centre", "Remote (Edinburgh)"
  phone           String? // primary contact number
  altEmail        String? // alternate / personal email for OOH escalation
  outOfHoursPhone String? // explicit OOH escalation number
  bio             String? // free text — skills, certifications, qualifications

  /// When this user last confirmed their contact details + role briefing
  /// ahead of an upcoming exercise. Drives the pre-exercise readiness
  /// banner ("Exercise X in 3 days — confirm details").
  lastReadinessCheckAt DateTime?

  // Tenant membership (one user → one org)
  orgId   String?
  org     Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  orgRole OrgRole?

  // Departmental org-chart membership (optional, separate from IMT roles).
  departmentId String?
  department   Department? @relation("DepartmentMember", fields: [departmentId], references: [id], onDelete: SetNull)
  ledDepartments Department[] @relation("DepartmentLead")

  accounts Account[]
  sessions Session[]

  createdScenarios        Scenario[]              @relation("ScenarioCreator")
  facilitatedExercises    Exercise[]              @relation("ExerciseFacilitator")
  exerciseParticipations  ExerciseParticipant[]
  incidentLogEntries      IncidentLogEntry[]
  responses               ParticipantResponse[]
  commsAuthored           CommunicationDraft[]    @relation("CommsAuthor")
  commsApproved           CommunicationDraft[]    @relation("CommsApprover")
  debriefAnswers          DebriefAnswer[]
  invitationsSent         Invitation[]            @relation("InvitationInvitedBy")
  uploadedArtefacts       Artefact[]              @relation("ArtefactUploader")
  ownedIBS                OrganizationIBS[]       @relation("IBSProcessOwner")
  createdIBS              OrganizationIBS[]       @relation("IBSCreatedBy")
  ownedActionItems        ExerciseActionItem[]    @relation("ActionItemOwner")
  createdActionItems      ExerciseActionItem[]    @relation("ActionItemCreatedBy")
  auditActions            AuditLogEntry[]         @relation("AuditActor")
  incidentsInvoked        Incident[]              @relation("IncidentInvoker")
  incidentsClosed         Incident[]              @relation("IncidentCloser")
  decisionsAuthoredByUser DecisionRecord[]        @relation("DecisionAuthorUser")
  decisionsApprovedByUser DecisionRecord[]        @relation("DecisionApproverUser")
  regulatorNotifications  RegulatorNotification[] @relation("RegulatorNotificationOwner")
  postIncidentReports     PostIncidentReport[]    @relation("PIRAuthor")
  imtMeetingsRecorded     IMTMeeting[]            @relation("IMTMeetingScribe")
  bcpActivations          BCPActivation[]         @relation("BCPActivator")
  bcpDeactivations        BCPActivation[]         @relation("BCPDeactivator")
  defaultRoleHoldings     OrganizationRole[]      @relation("RoleDefaultHolder")
  ibsAttestationsReviewed IBSAttestation[]        @relation("AttestationReviewer")
  drTestsAttested         DRTest[]                @relation("DRTestAttester")
  heldSeats               ExerciseSeat[]          @relation("SeatHolder")
  chatMessages            ChatMessage[]           @relation("ChatAuthor")
  reactions               Reaction[]              @relation("ReactionAuthor")
  scratchpadEdits         ExerciseScratchpad[]    @relation("ScratchpadEditor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Scenario design ────────────────────────────────────────────────────────

model Scenario {
  id          String        @id @default(cuid())
  // Nullable when this is a system-level CMORG template (org-agnostic). When a
  // user clones a template into their org, orgId is set.
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  background  String
  agenda      String?
  dDayDate    DateTime
  durationMin Int           @default(120)
  createdById String?
  createdBy   User?         @relation("ScenarioCreator", fields: [createdById], references: [id])

  // ─── CMORG Dynamic Scenario Library metadata ─────────────────────────────
  isTemplate       Boolean    @default(false)
  templateOriginId String?
  templateOrigin   Scenario?  @relation("ScenarioTemplate", fields: [templateOriginId], references: [id], onDelete: SetNull)
  clones           Scenario[] @relation("ScenarioTemplate")

  category              String? // e.g. "Technology & Data (Cyber)", "CNI", "Third Party"
  srrRef                String? // Strategic Risk Register reference (e.g. "3.1, 3.2")
  tier                  FirmTier? // null = applies to any tier
  firmProfile           String? // human label e.g. "Global Universal Bank", "Digital Challenger", "BaaS-dependent fintech"
  cause                 String?
  impactNarrative       String?
  characteristics       String[]
  assumptions           String[]
  compoundScenarioNotes String?
  takeaways             String?
  stressVariables       Json?
  caseStudy             Json? // { title, causation, impactScale, duration, sourceUrl? }

  // Annual programme planning — which year + quarter this scenario is
  // slotted into, and whether it satisfies a named regulatory commitment.
  programmeYear     Int? // 2026
  programmeQuarter  Int? // 1..4
  regulatoryReq     String? // free text: "FCA SS1/21 annual cyber exercise", "BoE SSE 2026", etc.
  mandatoryUntil    DateTime? // if set, the scenario must be exercised by this date

  // 6-box Risk Coverage matrix from the DSL
  coversPeople           Boolean @default(false)
  coversProperty         Boolean @default(false)
  coversTechnology       Boolean @default(false)
  coversDataAvailability Boolean @default(false)
  coversDataIntegrity    Boolean @default(false)
  coversThirdParty       Boolean @default(false)

  ibsList              ImportantBusinessService[]
  events               Event[]
  injects              Inject[]
  facilitatorQuestions FacilitatorQuestion[]
  debriefQuestions     DebriefQuestion[]
  exercises            Exercise[]
  artefacts            Artefact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportantBusinessService {
  id                 String   @id @default(cuid())
  scenarioId         String
  scenario           Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  impactToleranceMin Int
  impactMetrics      String?
  criticality        String

  events   EventIBS[]
  breaches ImpactBreach[]

  @@unique([scenarioId, code])
}

model Event {
  id              String   @id @default(cuid())
  scenarioId      String
  scenario        Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  eventNo         Int
  scheduledTime   String
  isScheduled     Boolean  @default(true)
  title           String
  description     String
  expectedActions String[]
  objectives      String[]

  // Addressing — resolved per-exercise by matching ExerciseParticipant.roleTitle
  senderRoleTitle String?
  toRoleTitles    String[]
  ccRoleTitles    String[]

  ibsLinks  EventIBS[]
  injects   Inject[]
  artefacts Artefact[]
  releases  EventRelease[]
  receipts  EventReceipt[]

  createdAt DateTime @default(now())

  @@unique([scenarioId, eventNo])
}

model EventIBS {
  eventId String
  ibsId   String
  event   Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ibs     ImportantBusinessService @relation(fields: [ibsId], references: [id], onDelete: Cascade)

  @@id([eventId, ibsId])
}

enum InjectKind {
  BUSINESS  // ops / customer / comms / regulator-driven pressure
  TECHNICAL // monitoring signals, observability alerts, system fault patterns
}

model Inject {
  id            String     @id @default(cuid())
  scenarioId    String
  scenario      Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?     @relation(fields: [eventId], references: [id])
  injectNo      Int
  scheduledTime String
  isScheduled   Boolean    @default(true)
  kind          InjectKind @default(BUSINESS)
  summary       String
  description   String
  relation      String?
  payload       Json?

  // Addressing — resolved per-exercise by matching ExerciseParticipant.roleTitle
  senderRoleTitle String?
  toRoleTitles    String[]
  ccRoleTitles    String[]

  artefacts        Artefact[]
  releases         InjectRelease[]
  responses        ParticipantResponse[]
  receipts         InjectReceipt[]
  triggeredDecisions DecisionRecord[] @relation("DecisionTriggerInject")

  createdAt DateTime @default(now())

  @@unique([scenarioId, injectNo])
}

model Artefact {
  id           String    @id @default(cuid())
  scenarioId   String?
  scenario     Scenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  exerciseId   String?
  exercise     Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  injectId     String?
  inject       Inject?   @relation(fields: [injectId], references: [id], onDelete: Cascade)
  kind         String // FACILITATOR_GUIDE | PARTICIPANT_GUIDE | SCENARIO_GUIDE | ALERT | EMAIL | REPORT | DOC | LOG | OTHER
  title        String
  description  String?
  blobUrl      String
  blobPath     String? // pathname inside the blob store (for deletion)
  contentType  String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?     @relation("ArtefactUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
}

model FacilitatorQuestion {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category   String
  text       String
  orderIdx   Int      @default(0)
}

model DebriefQuestion {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category   String
  text       String
  orderIdx   Int      @default(0)

  answers DebriefAnswer[]
}

// ─── Exercise lifecycle (planning → execution → debrief) ────────────────────

enum ExerciseStatus {
  PLANNING
  READY
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum ExerciseRole {
  FACILITATOR
  LEAD
  PARTICIPANT
  OBSERVER
}

model Exercise {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scenarioId    String
  scenario      Scenario     @relation(fields: [scenarioId], references: [id])
  facilitatorId String?
  facilitator   User?        @relation("ExerciseFacilitator", fields: [facilitatorId], references: [id])

  title       String
  description String?
  plannedDate DateTime?
  location    String?
  status      ExerciseStatus @default(PLANNING)

  startedAt       DateTime?
  pausedAt        DateTime?
  completedAt     DateTime?
  dDayAnchor      DateTime?
  speedMultiplier Float     @default(1.0)

  teams          ExerciseTeam[]
  participants   ExerciseParticipant[]
  eventReleases  EventRelease[]
  injectReleases InjectRelease[]
  incidentLog    IncidentLogEntry[]
  responses      ParticipantResponse[]
  comms          CommunicationDraft[]
  recoveryPlans  RecoveryPlan[]
  debriefAnswers DebriefAnswer[]
  impactBreaches ImpactBreach[]
  aar            AfterActionReport?
  artefacts      Artefact[]
  ibsLinks       ExerciseIBSLink[]
  actionItems    ExerciseActionItem[]
  incidents      Incident[]
  retrospective  Retrospective?
  seats          ExerciseSeat[]
  chatMessages   ChatMessage[]
  scratchpad     ExerciseScratchpad?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExerciseTeam {
  id          String    @id @default(cuid())
  exerciseId  String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  name        String
  description String?
  orderIdx    Int       @default(0)
  /// Policy-aligned team type. IMT = strategic oversight; IRT_TECH/IRT_CUSTOMER
  /// = tactical response ; COMMS = communications team;
  /// BRT_* = Business Recovery Teams (BCP §6.6); EXECUTIVE_OBSERVERS / ACTION_COMMITTEE
  /// = governance. OTHER = legacy / unclassified.
  kind        TeamKind? @default(OTHER)

  members ExerciseParticipant[]

  @@unique([exerciseId, name])
}

enum TeamKind {
  IMT
  IRT_TECH
  IRT_CUSTOMER
  COMMS
  BRT_FINANCE
  BRT_BUILDINGS
  BRT_TECH
  BRT_COMMS
  EXECUTIVE_OBSERVERS
  ACTION_COMMITTEE
  OTHER
}

model ExerciseParticipant {
  id           String        @id @default(cuid())
  exerciseId   String
  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId       String?
  team         ExerciseTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roleTitle    String // e.g. "CTO", "Sn.TPM", "ISM"
  exerciseRole ExerciseRole  @default(PARTICIPANT)
  joinedAt     DateTime      @default(now())
  lastSeenAt   DateTime?
  /// Free-text presence broadcast — e.g. "On a call with FCA" — shown to
  /// teammates so they know you're momentarily unavailable. Null = available.
  onCallStatus String?
  onCallSince  DateTime?

  /// Deputy chain . When a participant is unreachable, the
  /// deputy steps up. Pointer to another participant in the same exercise.
  deputyParticipantId String?
  deputy              ExerciseParticipant?  @relation("ParticipantDeputy", fields: [deputyParticipantId], references: [id], onDelete: SetNull)
  deputyFor           ExerciseParticipant[] @relation("ParticipantDeputy")
  /// Mobilisation status (B). Set when an IMT seat is "stood up" or marked unreachable.
  mobilisationStatus  MobilisationStatus    @default(UNCALLED)
  mobilisedAt         DateTime?

  eventReceipts  EventReceipt[]
  injectReceipts InjectReceipt[]

  decisionsAuthored  DecisionRecord[] @relation("DecisionAuthor")
  decisionsApproved  DecisionRecord[] @relation("DecisionApprover")
  sitrepsAuthored    Sitrep[]
  imtMeetingsChaired IMTMeeting[]     @relation("IMTMeetingChair")

  @@unique([exerciseId, userId])
}

enum MobilisationStatus {
  UNCALLED
  MOBILISED
  UNREACHABLE
  DEPUTY_STEPPED_UP
  STOOD_DOWN
}

model EventRelease {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  releasedAt  DateTime @default(now())
  triggeredBy String?

  @@unique([exerciseId, eventId])
}

model InjectRelease {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  injectId    String
  inject      Inject   @relation(fields: [injectId], references: [id], onDelete: Cascade)
  releasedAt  DateTime @default(now())
  triggeredBy String?

  @@unique([exerciseId, injectId])
}

/// War-room log. Per best practice the incident log is the master timeline
/// of observations, decisions, actions, risks, asks and evidence. Decisions
/// have additional structure in DecisionRecord (linked via decisionRecordId).
model IncidentLogEntry {
  id         String    @id @default(cuid())
  exerciseId String
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id])
  dDayTime   String
  kind       LogKind   @default(NOTE)
  body       String

  decisionRecord DecisionRecord?

  createdAt DateTime @default(now())

  @@index([exerciseId, createdAt])
}

enum LogKind {
  OBSERVATION
  DECISION
  ACTION
  RISK
  ASK
  EVIDENCE
  CHALLENGE
  RESOURCE
  NOTE
}

model ParticipantResponse {
  id              String   @id @default(cuid())
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  injectId        String
  inject          Inject   @relation(fields: [injectId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  assessment      String
  proposedActions String
  stakeholders    String?
  resources       String?
  commsNeeds      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommsAudience {
  CUSTOMER
  REGULATOR
  INTERNAL
  SENIOR_MGMT
  MEDIA
}

enum CommsStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SUBMITTED
  SENT
  REJECTED
}

/// Stakeholder mapping per best practice Each stakeholder has an
/// execution owner (drafts) and an approver (signs off). Ordering rule:
/// Employees BEFORE Customers/Third-Parties; Customers WITH Third-Parties;
/// Media WITH Customers (IMP §6.3.0).
enum CommsStakeholder {
  EMPLOYEES
  CUSTOMERS
  REGULATORS
  SHAREHOLDERS
  MEDIA
  THIRD_PARTY_VENDORS
  INTERMEDIARIES
  ICO
  INSURERS
  OTHER
}

model CommunicationDraft {
  id              String            @id @default(cuid())
  exerciseId      String
  exercise        Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  incidentId      String?
  incident        Incident?         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?             @relation("CommsAuthor", fields: [authorId], references: [id])
  audience        CommsAudience
  /// Policy stakeholder (cf. IMP §6.3.1 stakeholder table). The legacy `audience`
  /// is kept for back-compat; new code should set `stakeholder` for ordering rules.
  stakeholder     CommsStakeholder?
  subject         String
  body            String
  status          CommsStatus       @default(DRAFT)
  approverId      String?
  approver        User?             @relation("CommsApprover", fields: [approverId], references: [id])
  approvedAt      DateTime?
  sentAt          DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([exerciseId, stakeholder])
}

model RecoveryPlan {
  id               String   @id @default(cuid())
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  priorityActions  String
  resourceAlloc    String?
  successCriteria  String?
  timelineEstimate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImpactBreach {
  id         String                   @id @default(cuid())
  exerciseId String
  exercise   Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  ibsId      String
  ibs        ImportantBusinessService @relation(fields: [ibsId], references: [id], onDelete: Cascade)
  detectedAt DateTime                 @default(now())
  dDayTime   String
  note       String?
}

model DebriefAnswer {
  id         String          @id @default(cuid())
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  questionId String
  question   DebriefQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?           @relation(fields: [authorId], references: [id])
  body       String

  createdAt DateTime @default(now())
}

/// Legacy free-form After-Action Report. Retained for back-compat; new
/// reports should use PostIncidentReport (IMP §6.5.3) which has the eight
/// mandatory sections.
model AfterActionReport {
  id         String   @id @default(cuid())
  exerciseId String   @unique
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  summary    String
  strengths  String?
  gaps       String?
  actions    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Inbox read receipts (per participant, per event/inject) ───────────────

model EventReceipt {
  id            String              @id @default(cuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participant   ExerciseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  readAt        DateTime            @default(now())

  @@unique([eventId, participantId])
}

model InjectReceipt {
  id            String              @id @default(cuid())
  injectId      String
  inject        Inject              @relation(fields: [injectId], references: [id], onDelete: Cascade)
  participantId String
  participant   ExerciseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  readAt        DateTime            @default(now())

  @@unique([injectId, participantId])
}

// ─── Org-level IBS library, action items, audit log ────────────────────────

enum IBSStatus {
  DRAFT
  APPROVED
  DEPRECATED
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Organisation-level Important Business Service register. Maps to the
/// firm's formal IBS register (cf. CMORG / FCA / PRA operational-resilience
/// methodology). Per-scenario IBSs (model ImportantBusinessService) remain
/// as template fixtures; OrganizationIBS is the firm's canonical register
/// that exercises and reports refer to.
model OrganizationIBS {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  code        String // e.g. "IBS_01"
  name        String
  outcome     String? // e.g. "New and existing customers can open deposit accounts"
  description String?
  status      IBSStatus @default(DRAFT)

  // Governance
  processType        String? // e.g. "A", "B"
  processOwner       String? // free text role title
  processOwnerUserId String?
  processOwnerUser   User?     @relation("IBSProcessOwner", fields: [processOwnerUserId], references: [id], onDelete: SetNull)
  secondLineReviewer String?
  approvedAt         DateTime?
  reviewDueAt        DateTime?

  // Departmental ownership — which business unit owns this IBS end-to-end.
  ownerDepartmentId  String?
  ownerDepartment    Department? @relation("IBSOwnerDepartment", fields: [ownerDepartmentId], references: [id], onDelete: SetNull)

  // Annual self-attestation chain (FCA SS1/21 expects an annual review
  // signed by 1st-line, 2nd-line, and the executive accountable.)
  attestations IBSAttestation[]

  // Methodology
  customerJourneys String[]
  productsCovered  String[]

  // Impact tolerance
  impactToleranceMin Int // Primary tolerance (minutes)
  fcaToleranceMin    Int?
  praToleranceMin    Int?
  toleranceRationale String?
  criticality        ImpactLevel @default(HIGH)

  // Mapping (the IBS "resource map")
  technology   String[]
  peopleNotes  String?
  facilities   String?
  thirdParties String[]
  information  String[]
  processes    String[]

  // Importance assessment (six standard dimensions)
  impactCustomerFinancial  ImpactLevel?
  impactVulnerableCustomer ImpactLevel?
  impactLossOfLicense      ImpactLevel?
  impactRegulatoryFine     ImpactLevel?
  impactReputational       ImpactLevel?
  impactLossOfCapital      ImpactLevel?

  // 6-box risk coverage (parallel to Scenario)
  coversPeople           Boolean @default(false)
  coversProperty         Boolean @default(false)
  coversTechnology       Boolean @default(false)
  coversDataAvailability Boolean @default(false)
  coversDataIntegrity    Boolean @default(false)
  coversThirdParty       Boolean @default(false)

  // Free-text long-form sections (markdown)
  importanceAssessmentNotes String?
  vulnerabilitiesNotes      String?
  testingNotes              String?

  createdById String?
  createdBy   User?    @relation("IBSCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exerciseLinks ExerciseIBSLink[]
  vendorLinks   VendorIBSLink[]

  @@unique([orgId, code])
}

/// Three-line-of-defence attestation entry for an IBS. Each annual review
/// produces one record per line that signs off — typically FIRST_LINE
/// (process owner), SECOND_LINE (operational risk / oversight),
/// EXECUTIVE (the SMF accountable executive). Read sequentially as a
/// chain to determine the IBS's current attestation status.
enum AttestationLine {
  FIRST_LINE
  SECOND_LINE
  EXECUTIVE
}

enum AttestationStatus {
  REQUESTED
  ATTESTED
  REJECTED
}

model IBSAttestation {
  id     String          @id @default(cuid())
  ibsId  String
  ibs    OrganizationIBS @relation(fields: [ibsId], references: [id], onDelete: Cascade)
  orgId  String // denormalised for cross-IBS queries
  cycle  String // human label for the attestation cycle e.g. "2025-Q1", "2025-FY"
  line   AttestationLine
  status AttestationStatus @default(REQUESTED)

  reviewerId String? // who attested / rejected — null for REQUESTED
  reviewer   User?   @relation("AttestationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  reviewedAt DateTime? // when the reviewer signed off / rejected
  comment    String?
  createdAt  DateTime  @default(now())

  @@index([ibsId])
  @@index([orgId, status])
  @@unique([ibsId, cycle, line])
}

/// Which org-level IBSs an exercise is testing.
model ExerciseIBSLink {
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  ibsId      String
  ibs        OrganizationIBS @relation(fields: [ibsId], references: [id], onDelete: Cascade)
  notes      String?

  @@id([exerciseId, ibsId])
}

/// Action items captured during/after an exercise. Surfaced in AAR and on
/// the org-wide /action-items tracker. Real OR programmes generate ~5–15
/// of these per exercise.
enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  WONT_FIX
  BLOCKED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ExerciseActionItem {
  id         String       @id @default(cuid())
  exerciseId String
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  orgId      String // denormalised for cross-exercise queries
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title       String
  description String?
  ownerUserId String?
  ownerUser   User?              @relation("ActionItemOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerText   String? // when owner isn't an in-system user (yet)
  dueAt       DateTime?
  priority    ActionItemPriority @default(MEDIUM)
  status      ActionItemStatus   @default(OPEN)
  evidenceUrl String?

  createdById String?
  createdBy   User?     @relation("ActionItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?
}

/// Lightweight audit log for regulator-facing accountability. Recorded at
/// the boundary of major actions (CRUD on scenarios / exercises / members /
/// IBS, role changes, invitation actions).
model AuditLogEntry {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String // e.g. "scenario.created", "exercise.started", "ibs.approved", "member.removed"
  targetType String // "scenario" | "exercise" | "ibs" | "user" | "invitation" | …
  targetId   String?
  summary    String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

/// Reusable team templates for exercises (e.g. "Incident Management",
/// "Tech Recovery"). When admins plan an exercise, they can pick from these
/// instead of re-creating teams each time.
model OrganizationTeamTemplate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  orderIdx    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
}

// ─── Policy-aligned incident management (incident-management doctrine) ──────────────

/// An Incident is a live response episode inside an Exercise. An exercise can
/// have ≥0 incidents — most have exactly one, but escalating scenarios may
/// stand up a second. State machine mirrors best practice
model Incident {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  shortCode  String // e.g. "INC-2026-05-12-A" — used in MS Teams channel naming
  title      String
  summary    String?

  status IncidentStatus @default(DECLARED)

  // Invocation (IMP §6.2.2–3)
  invokedAt           DateTime?
  invokedById         String?
  invokedBy           User?     @relation("IncidentInvoker", fields: [invokedById], references: [id], onDelete: SetNull)
  invocationRationale String?

  // Stand-down (the "back down" half of "stand it up and back down")
  stoodDownAt     DateTime?
  stoodDownReason String?

  // Severity (IMP §6.2.1 + ORP App.1)
  severity             SeverityLevel?
  severityFinancial    SeverityLevel?
  severityCustomer     SeverityLevel?
  severityData         SeverityLevel?
  severitySystems      SeverityLevel?
  severityReputational SeverityLevel?
  /// Aggravating factor — Consumer Duty PS22/3 (IMP §6.2.4). When true, severity
  /// is promoted regardless of the financial threshold.
  consumerDutyTrigger  Boolean        @default(false)
  /// Aggravating factor — cyber/ransomware/data exfiltration default to High
  /// severity (BCPlans §6.3.8).
  cyberDefaultHigh     Boolean        @default(false)
  severityAssessedAt   DateTime?

  // Closure (IMP §6.4.1 — five mandatory criteria)
  closedAt              DateTime?
  closedById            String?
  closedBy              User?     @relation("IncidentCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closureImpactCeased   Boolean   @default(false)
  closureRegsNotified   Boolean   @default(false)
  closureLogComplete    Boolean   @default(false)
  closurePreliminaryRCA Boolean   @default(false)
  closureCRO_SignOff    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logEntries             IncidentLogEntry[]
  decisions              DecisionRecord[]
  sitreps                Sitrep[]
  imtMeetings            IMTMeeting[]
  regulatorNotifications RegulatorNotification[]
  comms                  CommunicationDraft[]
  bcpActivations         BCPActivation[]
  postIncidentReport     PostIncidentReport?

  @@index([exerciseId, status])
}

enum IncidentStatus {
  DECLARED // Observed, not yet invoked
  INVOKED // CEO has stood up the IMT
  CONTAINED // Tactical containment in place
  RESOLVED // Service restored; cleanup ongoing
  STOOD_DOWN // Invoked then stood down without escalation
  CLOSED // Five closure criteria met
}

enum SeverityLevel {
  HIGH
  MEDIUM
  LOW
}

// ─── Decisions (best practice — structured incident log) ──────────────────

/// A structured Decision recorded against an Incident. Distinct from a free-text
/// IncidentLogEntry — captures authority, rationale, approver. Each
/// DecisionRecord has a corresponding IncidentLogEntry of kind DECISION which
/// is what appears in the chronological log.
model DecisionRecord {
  id         String           @id @default(cuid())
  incidentId String
  incident   Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  logEntryId String           @unique
  logEntry   IncidentLogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  decisionType DecisionType
  title        String
  rationale    String?

  authorParticipantId String?
  authorParticipant   ExerciseParticipant? @relation("DecisionAuthor", fields: [authorParticipantId], references: [id], onDelete: SetNull)
  authorUserId        String?
  authorUser          User?                @relation("DecisionAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)

  /// Roles whose approval is required by policy for this decision type.
  /// e.g. "Activate BCP" requires CEO + CRO joint.
  approverRolesRequired String[]
  approverParticipantId String?
  approverParticipant   ExerciseParticipant? @relation("DecisionApprover", fields: [approverParticipantId], references: [id], onDelete: SetNull)
  approverUserId        String?
  approverUser          User?                @relation("DecisionApproverUser", fields: [approverUserId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?

  /// Optional link to the inject that triggered this decision. Captured
  /// in the live decision form (defaulting to the most recently released
  /// inject) so the post-incident review can reconstruct cause→effect.
  triggeredByInjectId String?
  triggeredByInject   Inject? @relation("DecisionTriggerInject", fields: [triggeredByInjectId], references: [id], onDelete: SetNull)

  dDayTime  String
  createdAt DateTime @default(now())
}

/// Canonical decision templates from incident-management doctrine. UI offers these as a
/// pick-list when a participant records a decision so we capture authority &
/// approver consistently.
enum DecisionType {
  INVOKE_IMT
  STAND_DOWN_IMT
  CLASSIFY_SEVERITY
  ACTIVATE_BCP
  DEACTIVATE_BCP
  NOTIFY_FCA
  NOTIFY_PRA
  NOTIFY_ICO
  CONVENE_ACTION_COMMITTEE
  APPROVE_CRISIS_COMMS
  APPROVE_REGULATOR_COMMS
  CFO_EMERGENCY_SPEND
  DRAW_CONTINGENT_LIQUIDITY
  DO_NOT_PAY_RANSOM
  INSURANCE_INVOCATION
  RECOVERY_OPTION_CHOSEN
  OTHER
}

// ─── Sitreps (BCP §6.4.3.1 — IMT requires initial sitrep from each BU) ──────

model Sitrep {
  id                 String       @id @default(cuid())
  incidentId         String
  incident           Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  businessUnit       String // e.g. "Tech Recovery", "Customer Operations"
  status             SitrepStatus
  summary            String
  issues             String?
  asks               String?
  nextUpdateDDayTime String? // when the next sitrep is expected (HH:MM)
  dDayTime           String

  authorParticipantId String?
  authorParticipant   ExerciseParticipant? @relation(fields: [authorParticipantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
}

enum SitrepStatus {
  GREEN
  AMBER
  RED
}

// ─── IMT meetings (IMP §6.2.5 standing agenda) ──────────────────────────────

model IMTMeeting {
  id              String   @id @default(cuid())
  incidentId      String
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  meetingNumber   Int // 1, 2, 3…
  startedAtDDay   String // HH:MM on the D-Day clock
  /// Required output of every meeting per IMP §6.2.5.
  nextMeetingDDay String?

  // Standing agenda fields
  situation String?
  decisions String? // free-text minute of decisions (linked DecisionRecords also available)
  actions   String? // free-text minute of actions
  risks     String?

  chairParticipantId String?
  chairParticipant   ExerciseParticipant? @relation("IMTMeetingChair", fields: [chairParticipantId], references: [id], onDelete: SetNull)
  scribeUserId       String?
  scribeUser         User?                @relation("IMTMeetingScribe", fields: [scribeUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ─── Regulator notifications (IMP §6.3.1.2 — countdown clocks) ──────────────

enum Regulator {
  FCA
  PRA
  ICO
  BANK_OF_ENGLAND
  OTHER
}

enum RegulatorNotificationStatus {
  PENDING
  IN_DRAFT
  AWAITING_APPROVAL
  SENT
  BREACHED // dueAt passed without being sent
  WAIVED // documented determination that notification not required
}

model RegulatorNotification {
  id                String    @id @default(cuid())
  incidentId        String
  incident          Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  regulator         Regulator
  trigger           String // e.g. "High-severity incident invoked", "Personal data breach suspected"
  /// SLA in hours from the triggering event. FCA/PRA = 4h post-invocation;
  /// ICO = 72h post-awareness; closure notification = 2 business days.
  slaHours          Int
  dueAt             DateTime
  ownerUserId       String?
  ownerUser         User?     @relation("RegulatorNotificationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerRoleTitle    String? // canonical owner role per IMP table (e.g. "CRO")
  approverRoleTitle String? // canonical approver per IMP table (e.g. "CEO")

  status          RegulatorNotificationStatus @default(PENDING)
  sentAt          DateTime?
  waiverRationale String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId, dueAt])
}

// ─── Business Continuity activation (BCP §6.4.2.2) ──────────────────────────

model BCPActivation {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  activatedAt      DateTime
  activatedByCEOId String?
  activatedByCEO   User?    @relation("BCPActivator", fields: [activatedByCEOId], references: [id], onDelete: SetNull)
  activatedByCROId String?
  activatedByCRO   User?    @relation("BCPDeactivator", fields: [activatedByCROId], references: [id], onDelete: SetNull)
  rationale        String?

  deactivatedAt     DateTime?
  deactivationNotes String?

  createdAt DateTime @default(now())
}

// ─── Critical third parties (BCPlans §6.3.6) ────────────────────────────────

model Vendor {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  /// Service the vendor provides — short label, e.g. "Core banking", "Payments".
  serviceKind  String?
  tier         VendorTier @default(TIER_2)
  /// Primary technical / commercial contact.
  contactName  String?
  contactEmail String?
  contactPhone String?
  /// Where to look for status (e.g. "status.thoughtmachine.io").
  statusUrl    String?
  notes        String?

  // ─── DORA / ICT-third-party register ───────────────────────────────
  isDoraCritical  Boolean    @default(false)
  doraIctTier     VendorTier? // ICT-third-party tier; may differ from commercial tier
  hyperscaler     String?     // "AWS", "GCP", "Azure", "OCI", etc. — for 4th-party concentration
  region          String?     // e.g. "eu-west-2", used to detect regional concentration

  // ─── Contract ──────────────────────────────────────────────────────
  contractStartAt           DateTime?
  contractEndAt             DateTime?
  contractRenewalNoticeDays Int?
  contractAnnualValueGBP    Int?

  // ─── Assurance ─────────────────────────────────────────────────────
  /// "SOC2_TYPE_2" | "SOC2_TYPE_1" | "ISAE3402" | "ISO27001" | "NONE"
  assuranceKind   String?
  assuranceExpiryAt DateTime?

  // ─── Exit plan ─────────────────────────────────────────────────────
  exitPlanReviewedAt DateTime?
  exitPlanRTOMin     Int?     // time to exit & switch in minutes
  exitPlanNotes      String?

  // 4th-party register — JSON array of { name, role, hyperscaler?, region? }
  fourthParties Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ibsLinks VendorIBSLink[]

  @@unique([orgId, name])
}

enum VendorTier {
  TIER_1 // Mission-critical (Thought Machine, ClearBank, AWS)
  TIER_2 // Business-critical
  TIER_3 // Business-operational
}

/// Links a Vendor to the IBSs it supports — so on a vendor outage we can show
/// "These IBSs are at risk".
model VendorIBSLink {
  vendorId String
  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ibsId    String
  ibs      OrganizationIBS @relation(fields: [ibsId], references: [id], onDelete: Cascade)
  notes    String?

  @@id([vendorId, ibsId])
}

// ─── Post-Incident Report (IMP §6.5.3 — 10 business days) ───────────────────

model PostIncidentReport {
  id         String   @id @default(cuid())
  incidentId String   @unique
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  dueAt       DateTime
  submittedAt DateTime?

  // Eight mandatory sections (IMP §6.5.3)
  incidentSummary        String?
  timeline               String?
  rootCause              String?
  customerImpact         String?
  regulatoryImpact       String?
  controlFailures        String?
  whatWorkedWell         String?
  remediationCommitments String?

  authorUserId String?
  authorUser   User?   @relation("PIRAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Retrospective (BCPlans §6.6.1 R-5 — 5 business days post-closure) ──────

model Retrospective {
  id         String    @id @default(cuid())
  exerciseId String    @unique
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  dueAt      DateTime
  heldAt     DateTime?

  wentWell     String?
  didntGoWell  String?
  improvements String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Role-as-seat model ────────────────────────────────────────────────────
//
// Roles are an org-level concept (CEO, CRO, CTO…). An ExerciseSeat is a
// role × exercise that may be empty or claimed live. Addressing on
// events/injects matches by role abbreviation — so when someone claims the
// CRO seat in the middle of an exercise, every message addressed to "CRO"
// routes to them immediately.

model OrganizationRole {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title          String // "Chief Risk Officer"
  abbreviation   String // "CRO" — matches inject/event addressing strings
  responsibility String? // 1-line description of the seat
  isSMF          Boolean @default(false)
  isExecutive    Boolean @default(false)
  orderIdx       Int     @default(0)

  // Deputy chain — this role is the deputy of another role. If the primary's
  // seat is empty/unreachable, the deputy is expected to step up.
  deputyOfRoleId String?
  deputyOf       OrganizationRole?  @relation("RoleDeputy", fields: [deputyOfRoleId], references: [id], onDelete: SetNull)
  deputies       OrganizationRole[] @relation("RoleDeputy")

  // Standing holder — who normally sits in this seat outside an exercise.
  // Used as a suggestion when claiming seats live.
  defaultHolderId String?
  defaultHolder   User?   @relation("RoleDefaultHolder", fields: [defaultHolderId], references: [id], onDelete: SetNull)

  seats ExerciseSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, abbreviation])
  @@index([orgId])
}

enum SeatStatus {
  EMPTY // No one in the seat
  CLAIMED // Someone has taken the seat
  UNREACHABLE // The seat-holder is unreachable; deputy should step up
  DEPUTY_FILLED // A deputy from another role is covering
  STOOD_DOWN // The seat was filled but is now stood down
}

model ExerciseSeat {
  id         String           @id @default(cuid())
  exerciseId String
  exercise   Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  roleId     String
  role       OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  status       SeatStatus @default(EMPTY)
  holderUserId String?
  holderUser   User?      @relation("SeatHolder", fields: [holderUserId], references: [id], onDelete: SetNull)
  claimedAt    DateTime?
  vacatedAt    DateTime?

  /// True if this seat is filled by someone whose primary role is a deputy —
  /// useful for the UI to distinguish "deputy stepped up" from "primary".
  isDeputy Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([exerciseId, roleId])
  @@index([exerciseId, status])
}

// ─── Team chat (the back-channel real incidents need) ───────────────────────

model ChatMessage {
  id                     String   @id @default(cuid())
  exerciseId             String
  exercise               Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  authorId               String
  author                 User     @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Author's role at the moment they posted — denormalised for display so
  /// re-seating doesn't rewrite history.
  authorRoleAbbreviation String?
  body                   String
  /// dDayTime at the moment of posting — for chronological alignment in
  /// the post-exercise reconstruction.
  dDayTime               String?
  createdAt              DateTime @default(now())

  reactions Reaction[]

  @@index([exerciseId, createdAt])
}

// ─── Reactions (polymorphic on chat / log / decision / sitrep) ──────────────

enum ReactionTarget {
  CHAT
  LOG_ENTRY
  DECISION
  SITREP
}

model Reaction {
  id         String         @id @default(cuid())
  targetType ReactionTarget
  targetId   String
  userId     String
  user       User           @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  /// Emoji or short string. Kept loose so we can iterate on the picker.
  emoji      String
  createdAt  DateTime       @default(now())

  // FK to ChatMessage when targetType=CHAT (optional; makes cascade-delete clean)
  chatMessageId String?
  chatMessage   ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId, emoji])
  @@index([targetType, targetId])
}

// ─── Working-doc scratchpad (the shared Notion-style doc) ───────────────────

model ExerciseScratchpad {
  id             String   @id @default(cuid())
  exerciseId     String   @unique
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  body           String   @default("")
  lastEditedById String?
  lastEditedBy   User?    @relation("ScratchpadEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Technical recovery — system register + DR test ledger ──────────────────

enum TechSystemKind {
  APPLICATION
  INFRASTRUCTURE
  DATABASE
  NETWORK
  AUTH
  OBSERVABILITY
  OTHER
}

enum TechSystemTier {
  CRITICAL  // RTO < 1h, RPO measured in minutes
  ESSENTIAL // RTO < 4h
  IMPORTANT // RTO < 24h
  ROUTINE   // best effort
}

enum TechFailoverKind {
  ACTIVE_ACTIVE
  ACTIVE_PASSIVE
  WARM_STANDBY
  COLD_RESTORE
  NONE
}

enum DRTestOutcome {
  PASS
  PARTIAL
  FAIL
}

/// A technical system that supports one or more IBSs. The recovery posture
/// for each — RTO/RPO/MTPD, failover topology, backup story — lives here.
model TechSystem {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String
  kind        TechSystemKind @default(APPLICATION)
  tier        TechSystemTier @default(IMPORTANT)
  description String?
  owner       String?

  // Objectives
  rtoMin  Int? // recovery time objective (minutes)
  rpoMin  Int? // recovery point objective (minutes)
  mtpdMin Int? // max tolerable period of disruption (minutes)

  // Failover topology
  primaryRegion  String?
  failoverRegion String?
  failoverKind   TechFailoverKind @default(NONE)

  // Backup posture
  backupFrequency       String? // free text e.g. "continuous", "hourly", "daily"
  backupRetentionDays   Int?
  lastBackupValidatedAt DateTime?

  // DR testing schedule + cadence. nextDrTestDueAt drives the "due-soon"
  // dashboard widget; drTestCadenceMonths is the firm-policy interval
  // (e.g. tier-1 systems tested every 3 months).
  drTestCadenceMonths Int?
  nextDrTestDueAt     DateTime?

  notes String?

  drTests DRTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

/// A DR-test result against a TechSystem. Used to derive "last tested" and
/// "actual RTO vs target" — the ledger the regulator asks for.
model DRTest {
  id       String     @id @default(cuid())
  systemId String
  system   TechSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  testedAt     DateTime
  outcome      DRTestOutcome @default(PASS)
  rtoActualMin Int?
  rpoActualMin Int?
  participants String? // free text who ran the test
  notes        String?

  // Tech-lead sign-off — the named accountable owner attests the result is
  // valid and any gap-to-target has been recorded for remediation.
  attestedById String?
  attestedBy   User?     @relation("DRTestAttester", fields: [attestedById], references: [id], onDelete: SetNull)
  attestedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([systemId])
}
