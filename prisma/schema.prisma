// Operational Resilience Exercise Simulator — schema
// Prisma 7 (driver-adapter ready for Neon serverless on Vercel)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant: Organization + Membership (1 user → 1 org) ────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum FirmTier {
  TIER_1 // Global universal / G-SIBs (HSBC, Barclays, JPM)
  TIER_2 // Digital challenger banks (Starling, Monzo, Revolut)
  TIER_3 // New banks, neobanks, EMIs, BaaS-dependent fintechs
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  tier                 FirmTier?
  logoBlobUrl          String?
  logoBlobPath         String?
  /// Hex accent colour ("#4f46e5") — overrides the brand --accent token
  /// across the app shell. Null = default indigo.
  accentHex            String?
  /// Default fully-loaded hourly cost per IMT role abbreviation, used to
  /// estimate exercise cost. JSON shape: { "CEO": 500, "CRO": 400, ... }
  /// in major currency units (GBP/EUR/USD). Null = use sector defaults.
  defaultExerciseRates Json?
  /// ISO 4217 currency code for cost surfacing (GBP / EUR / USD).
  exerciseCostCurrency String    @default("GBP")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// Named SMF accountable for operational resilience. The user who signs
  /// the executive line of the annual self-attestation.
  smfAccountableForResilienceUserId String?
  smfAccountableForResilience       User?   @relation("OrgResilienceSMF", fields: [smfAccountableForResilienceUserId], references: [id], onDelete: SetNull)

  /// Free-text name of the board / executive committee that takes the
  /// attested self-assessment (e.g. "Board Risk Committee").
  boardCommitteeForResilienceName String?

  /// Calendar month (1-12) the annual attestation cycle opens. Default
  /// (null) = January. Used by the cycle dashboard to compute due-dates.
  attestationCycleStartMonth Int?

  users                     User[]
  invitations               Invitation[]
  scenarios                 Scenario[]
  exercises                 Exercise[]
  ibsRegister               OrganizationIBS[]
  actionItems               ExerciseActionItem[]
  auditLog                  AuditLogEntry[]
  teamTemplates             OrganizationTeamTemplate[]
  vendors                   Vendor[]
  roles                     OrganizationRole[]
  techSystems               TechSystem[]
  departments               Department[]
  decisionTypes             OrgDecisionType[]
  vendorRegisterSnapshots   VendorRegisterSnapshot[]
  runbooks                  Runbook[]
  achievementUnlocks        AchievementUnlock[]
  resilienceAttestations    OrgResilienceAttestation[]
  resilienceMaterialChanges OrgResilienceMaterialChange[]
}

/// Departmental org-chart node — a business unit / team / function. Separate
/// from the IMT role catalogue (`OrganizationRole`): roles are *who sits in
/// the war-room during an exercise*; departments are *where you sit in the
/// org chart day-to-day*. An IBS can be owned end-to-end by a department;
/// a user can sit in a department. Nestable via parentId for true org-chart
/// hierarchy.
model Department {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name         String // "Retail Banking Technology"
  abbreviation String? // "RBT"
  description  String? // 1-line purpose statement
  orderIdx     Int     @default(0)

  // Hierarchy — null parent = top-level department
  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")

  // Lead — the named director / head accountable for the department.
  leadId String?
  lead   User?   @relation("DepartmentLead", fields: [leadId], references: [id], onDelete: SetNull)

  // Members of this department.
  members User[] @relation("DepartmentMember")

  // IBSs owned end-to-end by this department.
  ownedIBS OrganizationIBS[] @relation("IBSOwnerDepartment")

  // IBS resource-map links pointing at this department.
  ibsResources IBSResource[] @relation("IBSResourceDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

model Invitation {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        OrgRole      @default(MEMBER)
  token       String       @unique
  invitedById String?
  invitedBy   User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  // ── Onboard-drawer pre-fill ────────────────────────────────────────
  // Captured by the admin at invite-time and copied to the new User on
  // accept. All optional — admin can still send a bare-bones invite.
  prefillJobTitle        String?
  prefillPhone           String?
  prefillOutOfHoursPhone String?
  prefillLocation        String?

  @@unique([orgId, email])
}

// ─── Auth (NextAuth) ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Profile / contact — used for real-incident response, not just exercises.
  jobTitle        String? // "Group CRO", "Head of Tech Operations"
  location        String? // "London HQ", "Manchester ops centre", "Remote (Edinburgh)"
  phone           String? // primary contact number
  altEmail        String? // alternate / personal email for OOH escalation
  outOfHoursPhone String? // explicit OOH escalation number
  bio             String? // free text — skills, certifications, qualifications

  /// When this user last confirmed their contact details + role briefing
  /// ahead of an upcoming exercise. Drives the pre-exercise readiness
  /// banner ("Exercise X in 3 days — confirm details").
  lastReadinessCheckAt DateTime?

  /// "Since you were here last" anchor used by the dashboard recap card.
  /// Bumped on dashboard load but only when ≥ 4 hours have passed since
  /// the previous value — so a quick refresh doesn't reset the recap.
  /// Null = first dashboard visit; the recap card shows a welcome state.
  lastDashboardVisitAt DateTime?

  /// Calendar-day streak: number of consecutive days the user has visited
  /// the dashboard. Same-day visits are a no-op; yesterday increments;
  /// any gap resets to 1.
  dashboardStreakDays    Int       @default(0)
  /// The last calendar day (midnight UTC) the streak was incremented on.
  /// Compared to `today` to decide same-day / yesterday / reset.
  dashboardStreakLastDay DateTime?

  // Tenant membership (one user → one org)
  orgId   String?
  org     Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  orgRole OrgRole?

  // Departmental org-chart membership (optional, separate from IMT roles).
  departmentId   String?
  department     Department?  @relation("DepartmentMember", fields: [departmentId], references: [id], onDelete: SetNull)
  ledDepartments Department[] @relation("DepartmentLead")

  accounts Account[]
  sessions Session[]

  createdScenarios           Scenario[]                 @relation("ScenarioCreator")
  facilitatedExercises       Exercise[]                 @relation("ExerciseFacilitator")
  coFacilitatedExercises     Exercise[]                 @relation("ExerciseCoFacilitator")
  exerciseApprovalsGiven     ExerciseApproval[]         @relation("ExerciseApprover")
  classifiedReadsByMe        ExerciseClassifiedReader[] @relation("ClassifiedReadReader")
  vendorAssessmentsRecorded  VendorAssessment[]         @relation("VendorAssessmentRecorder")
  mtpNotificationsCreated    VendorMtpNotification[]    @relation("MtpNotificationCreator")
  registerSnapshotsCreated   VendorRegisterSnapshot[]   @relation("RegisterSnapshotCreator")
  createdRunbooks            Runbook[]                  @relation("RunbookCreator")
  reviewedRunbooks           Runbook[]                  @relation("RunbookReviewer")
  activatedRunbookExecutions RunbookExecution[]         @relation("RunbookExecutionActivator")
  facilitatorAnnouncements   FacilitatorAnnouncement[]  @relation("FacilitatorAnnouncementAuthor")
  achievementUnlocks         AchievementUnlock[]        @relation("AchievementUnlockUser")
  exerciseParticipations     ExerciseParticipant[]
  incidentLogEntries         IncidentLogEntry[]
  responses                  ParticipantResponse[]
  commsAuthored              CommunicationDraft[]       @relation("CommsAuthor")
  commsApproved              CommunicationDraft[]       @relation("CommsApprover")
  debriefAnswers             DebriefAnswer[]
  invitationsSent            Invitation[]               @relation("InvitationInvitedBy")
  uploadedArtefacts          Artefact[]                 @relation("ArtefactUploader")
  ownedIBS                   OrganizationIBS[]          @relation("IBSProcessOwner")
  createdIBS                 OrganizationIBS[]          @relation("IBSCreatedBy")
  ownedActionItems           ExerciseActionItem[]       @relation("ActionItemOwner")
  createdActionItems         ExerciseActionItem[]       @relation("ActionItemCreatedBy")
  auditActions               AuditLogEntry[]            @relation("AuditActor")
  incidentsInvoked           Incident[]                 @relation("IncidentInvoker")
  incidentsClosed            Incident[]                 @relation("IncidentCloser")
  decisionsAuthoredByUser    DecisionRecord[]           @relation("DecisionAuthorUser")
  decisionsApprovedByUser    DecisionRecord[]           @relation("DecisionApproverUser")
  regulatorNotifications     RegulatorNotification[]    @relation("RegulatorNotificationOwner")
  postIncidentReports        PostIncidentReport[]       @relation("PIRAuthor")
  imtMeetingsRecorded        IMTMeeting[]               @relation("IMTMeetingScribe")
  bcpActivations             BCPActivation[]            @relation("BCPActivator")
  bcpDeactivations           BCPActivation[]            @relation("BCPDeactivator")
  defaultRoleHoldings        OrganizationRole[]         @relation("RoleDefaultHolder")
  ibsAttestationsReviewed    IBSAttestation[]           @relation("AttestationReviewer")
  drTestsAttested            DRTest[]                   @relation("DRTestAttester")
  heldSeats                  ExerciseSeat[]             @relation("SeatHolder")
  chatMessages               ChatMessage[]              @relation("ChatAuthor")
  reactions                  Reaction[]                 @relation("ReactionAuthor")
  scratchpadEdits            ExerciseScratchpad[]       @relation("ScratchpadEditor")

  // Operational-resilience self-attestation chain (annual cycle, three-line sign-off)
  resilienceSMFAccountabilities  Organization[]                @relation("OrgResilienceSMF")
  openedResilienceAttestations   OrgResilienceAttestation[]    @relation("ResilienceAttestationOpener")
  firstLineResilienceSignatures  OrgResilienceAttestation[]    @relation("ResilienceAttestationFirstLine")
  secondLineResilienceSignatures OrgResilienceAttestation[]    @relation("ResilienceAttestationSecondLine")
  executiveResilienceSignatures  OrgResilienceAttestation[]    @relation("ResilienceAttestationExecutive")
  declaredMaterialChanges        OrgResilienceMaterialChange[] @relation("ResilienceMaterialChangeDeclarer")
  reviewedMaterialChanges        OrgResilienceMaterialChange[] @relation("ResilienceMaterialChangeReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Scenario design ────────────────────────────────────────────────────────

model Scenario {
  id          String        @id @default(cuid())
  // Nullable when this is a system-level CMORG template (org-agnostic). When a
  // user clones a template into their org, orgId is set.
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  background  String
  agenda      String?
  dDayDate    DateTime
  durationMin Int           @default(120)
  createdById String?
  createdBy   User?         @relation("ScenarioCreator", fields: [createdById], references: [id])

  // ─── CMORG Dynamic Scenario Library metadata ─────────────────────────────
  isTemplate       Boolean    @default(false)
  templateOriginId String?
  templateOrigin   Scenario?  @relation("ScenarioTemplate", fields: [templateOriginId], references: [id], onDelete: SetNull)
  clones           Scenario[] @relation("ScenarioTemplate")

  category              String? // e.g. "Technology & Data (Cyber)", "CNI", "Third Party"
  srrRef                String? // Strategic Risk Register reference (e.g. "3.1, 3.2")
  tier                  FirmTier? // null = applies to any tier
  firmProfile           String? // human label e.g. "Global Universal Bank", "Digital Challenger", "BaaS-dependent fintech"
  cause                 String?
  impactNarrative       String?
  characteristics       String[]
  assumptions           String[]
  compoundScenarioNotes String?
  takeaways             String?
  stressVariables       Json?
  caseStudy             Json? // { title, causation, impactScale, duration, sourceUrl? }

  // Annual programme planning — which year + quarter this scenario is
  // slotted into, and whether it satisfies a named regulatory commitment.
  programmeYear    Int? // 2026
  programmeQuarter Int? // 1..4
  regulatoryReq    String? // free text: "FCA SS1/21 annual cyber exercise", "BoE SSE 2026", etc.
  mandatoryUntil   DateTime? // if set, the scenario must be exercised by this date

  // 6-box Risk Coverage matrix from the DSL
  coversPeople           Boolean @default(false)
  coversProperty         Boolean @default(false)
  coversTechnology       Boolean @default(false)
  coversDataAvailability Boolean @default(false)
  coversDataIntegrity    Boolean @default(false)
  coversThirdParty       Boolean @default(false)

  // ─── Difficulty rating (1-5 per axis) ─────────────────────────────────────
  /// 1 = single failure with clear cascade.
  /// 5 = multiple simultaneous failures, cognitive overload.
  difficultyCognitive    Int?
  /// 1 = relaxed timeline.  5 = highly compressed regulator clocks.
  difficultyTimePressure Int?
  /// 1 = facts are clear.   5 = high "we don't know" content, conflicting signals.
  difficultyAmbiguity    Int?
  /// 1 = single team.       5 = many external parties (regulators, vendors, customers, media).
  difficultyStakeholders Int?

  ibsList              ImportantBusinessService[]
  events               Event[]
  injects              Inject[]
  facilitatorQuestions FacilitatorQuestion[]
  debriefQuestions     DebriefQuestion[]
  exercises            Exercise[]
  artefacts            Artefact[]
  chainedFromExercises ExerciseScenarioLink[]
  runbookLinks         RunbookScenarioLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportantBusinessService {
  id                 String   @id @default(cuid())
  scenarioId         String
  scenario           Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  impactToleranceMin Int
  impactMetrics      String?
  criticality        String

  /// Link to the org's canonical IBS register. Nullable to keep existing
  /// library / template rows working; new rows added via the scenario IBS
  /// tab always set this. Exercise readiness blocks transition to READY
  /// while any scenario IBS has a null link.
  organizationIBSId String?
  organizationIBS   OrganizationIBS? @relation("ScenarioIBSLink", fields: [organizationIBSId], references: [id], onDelete: SetNull)

  events   EventIBS[]
  breaches ImpactBreach[]

  @@unique([scenarioId, code])
  @@index([organizationIBSId])
}

model Event {
  id              String   @id @default(cuid())
  scenarioId      String
  scenario        Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  eventNo         Int
  scheduledTime   String
  isScheduled     Boolean  @default(true)
  title           String
  description     String
  expectedActions String[]
  objectives      String[]

  // Addressing — resolved per-exercise by matching ExerciseParticipant.roleTitle
  senderRoleTitle String?
  toRoleTitles    String[]
  ccRoleTitles    String[]

  ibsLinks  EventIBS[]
  injects   Inject[]
  artefacts Artefact[]
  releases  EventRelease[]
  receipts  EventReceipt[]

  createdAt DateTime @default(now())

  @@unique([scenarioId, eventNo])
}

model EventIBS {
  eventId String
  ibsId   String
  event   Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ibs     ImportantBusinessService @relation(fields: [ibsId], references: [id], onDelete: Cascade)

  @@id([eventId, ibsId])
}

enum InjectKind {
  BUSINESS // ops / customer / comms / regulator-driven pressure
  TECHNICAL // monitoring signals, observability alerts, system fault patterns
}

model Inject {
  id            String     @id @default(cuid())
  scenarioId    String
  scenario      Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?     @relation(fields: [eventId], references: [id])
  injectNo      Int
  scheduledTime String
  isScheduled   Boolean    @default(true)
  kind          InjectKind @default(BUSINESS)
  summary       String
  description   String
  relation      String?
  payload       Json?

  // Addressing — resolved per-exercise by matching ExerciseParticipant.roleTitle
  senderRoleTitle String?
  toRoleTitles    String[]
  ccRoleTitles    String[]

  artefacts          Artefact[]
  releases           InjectRelease[]
  responses          ParticipantResponse[]
  receipts           InjectReceipt[]
  triggeredDecisions DecisionRecord[]         @relation("DecisionTriggerInject")
  exerciseOverrides  ExerciseInjectOverride[]

  createdAt DateTime @default(now())

  @@unique([scenarioId, injectNo])
}

model Artefact {
  id           String    @id @default(cuid())
  scenarioId   String?
  scenario     Scenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  exerciseId   String?
  exercise     Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  injectId     String?
  inject       Inject?   @relation(fields: [injectId], references: [id], onDelete: Cascade)
  kind         String // FACILITATOR_GUIDE | PARTICIPANT_GUIDE | SCENARIO_GUIDE | ALERT | EMAIL | REPORT | DOC | LOG | OTHER
  title        String
  description  String?
  blobUrl      String
  blobPath     String? // pathname inside the blob store (for deletion)
  contentType  String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?     @relation("ArtefactUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
}

model FacilitatorQuestion {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category   String
  text       String
  orderIdx   Int      @default(0)
}

model DebriefQuestion {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category   String
  text       String
  orderIdx   Int      @default(0)

  answers DebriefAnswer[]
}

// ─── Exercise lifecycle (planning → execution → debrief) ────────────────────

enum ExerciseStatus {
  PLANNING
  READY
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum ExerciseType {
  TABLETOP
  LIVE
  WALKTHROUGH
}

enum Confidentiality {
  OPEN
  RESTRICTED
}

enum Jurisdiction {
  UK
  EU
  UK_AND_EU
  US
  GLOBAL
}

enum Classification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
}

enum ExerciseMode {
  PRODUCTION
  DRY_RUN
}

enum VendorParticipantScope {
  OBSERVER_ONLY
  RESPONDER_ROLE
  FULL_PARTICIPANT
}

enum ExerciseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExerciseRole {
  FACILITATOR
  LEAD
  PARTICIPANT
  OBSERVER
}

model Exercise {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scenarioId      String
  scenario        Scenario     @relation(fields: [scenarioId], references: [id])
  facilitatorId   String?
  facilitator     User?        @relation("ExerciseFacilitator", fields: [facilitatorId], references: [id])
  /// Optional backup facilitator. Single-facilitator design is anti-resilience;
  /// a named co-facilitator can take over if the primary becomes unavailable
  /// (and is the first port-of-call for participant questions during the live run).
  coFacilitatorId String?
  coFacilitator   User?        @relation("ExerciseCoFacilitator", fields: [coFacilitatorId], references: [id])

  title       String
  description String?
  plannedDate DateTime?
  location    String?
  status      ExerciseStatus @default(PLANNING)

  // ─── Wizard-era planning fields ───────────────────────────────────────────
  /// LIVE = real-time war-room; TABLETOP = facilitated discussion;
  /// WALKTHROUGH = explanatory tour, lowest realism.
  exerciseType         ExerciseType    @default(TABLETOP)
  /// Planned wall-clock duration in minutes. Used to size the briefing email,
  /// cost estimate, calendar invite, and pre-flight summary.
  durationMin          Int?
  /// IANA time-zone string (e.g. "Europe/London"). When set, D-Day is interpreted
  /// in this zone; participants in other zones see localised times. Null defaults
  /// to UTC interpretation.
  timeZone             String?
  /// OPEN = whole org sees the exercise in lists; RESTRICTED = only roster +
  /// explicit observers see it.
  confidentiality      Confidentiality @default(OPEN)
  /// 1-5 short outcome statements the exercise is intended to test
  /// (e.g. "Test 4h FCA notification path under cyber pressure"). Scored
  /// against in the debrief.
  objectives           String[]
  /// Optional jurisdictional scope. Drives which regulator-clock thresholds
  /// and notification helpers apply during severity classification.
  jurisdiction         Jurisdiction    @default(UK)
  /// Information-security classification. SECRET / CONFIDENTIAL enable
  /// watermarking and per-exercise restricted reader lists.
  classification       Classification  @default(INTERNAL)
  /// Optional one-line classification caveat (e.g. "MNPI", "DEAL-RELATED",
  /// "INSIDER LIST"). Surfaced in the page-header pill.
  classificationCaveat String?
  /// PRODUCTION exercises generate evidence and count toward annual obligations.
  /// DRY_RUN exercises are private facilitator rehearsals — purged after 30 days,
  /// excluded from regulator evidence packs, do not satisfy annual testing.
  mode                 ExerciseMode    @default(PRODUCTION)
  /// When set, this exercise was cloned from another exercise's design
  /// (template). Lets the programme view show "X used as template by N others".
  templateOfId         String?
  templateOf           Exercise?       @relation("ExerciseTemplate", fields: [templateOfId], references: [id], onDelete: SetNull)
  templateClones       Exercise[]      @relation("ExerciseTemplate")
  /// RFC 5545 RRULE string for recurring exercises (e.g. quarterly cyber drill).
  /// Null = one-off.
  recurrenceRule       String?

  // ─── Briefing tracking ────────────────────────────────────────────────────
  briefingSentAt        DateTime?
  /// Reason given when the facilitator skipped the pre-read briefing email
  /// (e.g. "Verbal brief in person at kickoff").
  briefingSkippedReason String?

  // ─── Cost (snapshot, GBP minor units / pence) ─────────────────────────────
  /// Estimated cost computed at planning time from roster × duration × role rates.
  /// Snapshot so rate changes don't retroactively alter past evidence.
  estimatedCostMinor Int?
  /// Actual cost computed at closure from attended-time × role rates.
  actualCostMinor    Int?

  // ─── Regulator-evidence mode ──────────────────────────────────────────────
  /// When true, all post-kickoff edits are locked, all decisions require an
  /// approver, comms require explicit sign-off, closure gates are strict-no-waivers,
  /// audit log writes are chained for tamper-evidence, and closure auto-generates
  /// a regulator evidence pack.
  regulatorMode            Boolean @default(false)
  /// Free-text label of the audience this evidence is being prepared for
  /// (e.g. "PRA SS1/21", "FCA SYSC 15A", "BoE FMI", "DORA Art. 25").
  regulatorAudience        String?
  /// URL to the generated evidence pack (Vercel Blob), set on closure when
  /// regulatorMode is true.
  regulatorEvidencePackUrl String?

  // ─── Real-incident abort path ─────────────────────────────────────────────
  /// Set when the exercise was aborted because a real incident took over.
  /// Distinguishes ABANDONED-for-real-incident from ABANDONED-because-no-show.
  abortedAt   DateTime?
  abortReason String?

  startedAt       DateTime?
  pausedAt        DateTime?
  completedAt     DateTime?
  dDayAnchor      DateTime?
  speedMultiplier Float     @default(1.0)

  teams                    ExerciseTeam[]
  participants             ExerciseParticipant[]
  eventReleases            EventRelease[]
  injectReleases           InjectRelease[]
  incidentLog              IncidentLogEntry[]
  responses                ParticipantResponse[]
  comms                    CommunicationDraft[]
  recoveryPlans            RecoveryPlan[]
  debriefAnswers           DebriefAnswer[]
  impactBreaches           ImpactBreach[]
  aar                      AfterActionReport?
  artefacts                Artefact[]
  ibsLinks                 ExerciseIBSLink[]
  actionItems              ExerciseActionItem[]
  incidents                Incident[]
  retrospective            Retrospective?
  seats                    ExerciseSeat[]
  chatMessages             ChatMessage[]
  scratchpad               ExerciseScratchpad?
  // ─── Wizard-era relations ─────────────────────────────────────────────────
  chainedScenarios         ExerciseScenarioLink[]
  vendorParticipants       ExerciseVendorParticipant[]
  approvals                ExerciseApproval[]
  injectOverrides          ExerciseInjectOverride[]
  hotWash                  ExerciseHotWash?
  wellbeingChecks          ExerciseWellbeingCheck[]
  classifiedReads          ExerciseClassifiedReader[]
  auditHashChain           ExerciseAuditHashEntry[]
  facilitatorAnnouncements FacilitatorAnnouncement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([orgId, plannedDate])
}

/// Out-of-band signals from the facilitator that participants need to see
/// as a discrete event rather than a buried log row — broadcasts ("pause
/// for a sitrep check"), bulk releases ("released 8 items up to D-Day
/// 09:00"), recalls ("inject X was un-released"), and clock scrubs
/// ("skipped 15 mins of dead time"). The participant /live view subscribes
/// to these via polling and surfaces toasts + a sticky banner.
model FacilitatorAnnouncement {
  id         String                      @id @default(cuid())
  exerciseId String
  exercise   Exercise                    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?                       @relation("FacilitatorAnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  kind       FacilitatorAnnouncementKind
  /// Human-readable message shown in the toast + banner.
  message    String
  /// Structured detail. Shape depends on kind:
  ///   BULK_RELEASE: { upToHHMM, eventCount, injectCount }
  ///   RECALL:       { kind: "EVENT"|"INJECT", summary }
  ///   SCRUB:        { deltaMinutes, direction: "FORWARD"|"BACKWARD" }
  ///   BROADCAST:    null
  metadata   Json?
  /// D-Day time captured at emission; null if exercise hasn't started.
  dDayTime   String?
  /// When non-null, the participant banner pins this announcement at the
  /// top until the participant dismisses it. Used for BROADCAST so the
  /// IMT chair's instruction can't be missed.
  pinned     Boolean                     @default(false)
  createdAt  DateTime                    @default(now())

  @@index([exerciseId, createdAt])
}

enum FacilitatorAnnouncementKind {
  BROADCAST
  BULK_RELEASE
  RECALL
  SCRUB
}

model ExerciseTeam {
  id          String    @id @default(cuid())
  exerciseId  String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  name        String
  description String?
  orderIdx    Int       @default(0)
  /// Policy-aligned team type. IMT = strategic oversight; IRT_TECH/IRT_CUSTOMER
  /// = tactical response ; COMMS = communications team;
  /// BRT_* = Business Recovery Teams; EXECUTIVE_OBSERVERS / ACTION_COMMITTEE
  /// = governance. OTHER = legacy / unclassified.
  kind        TeamKind? @default(OTHER)

  members ExerciseParticipant[]

  @@unique([exerciseId, name])
}

enum TeamKind {
  IMT
  IRT_TECH
  IRT_CUSTOMER
  COMMS
  BRT_FINANCE
  BRT_BUILDINGS
  BRT_TECH
  BRT_COMMS
  EXECUTIVE_OBSERVERS
  ACTION_COMMITTEE
  OTHER
}

model ExerciseParticipant {
  id           String        @id @default(cuid())
  exerciseId   String
  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId       String?
  team         ExerciseTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roleTitle    String // e.g. "CTO", "Sn.TPM", "ISM"
  exerciseRole ExerciseRole  @default(PARTICIPANT)
  joinedAt     DateTime      @default(now())
  lastSeenAt   DateTime?
  /// Free-text presence broadcast — e.g. "On a call with FCA" — shown to
  /// teammates so they know you're momentarily unavailable. Null = available.
  onCallStatus String?
  onCallSince  DateTime?

  /// Deputy chain . When a participant is unreachable, the
  /// deputy steps up. Pointer to another participant in the same exercise.
  deputyParticipantId String?
  deputy              ExerciseParticipant?  @relation("ParticipantDeputy", fields: [deputyParticipantId], references: [id], onDelete: SetNull)
  deputyFor           ExerciseParticipant[] @relation("ParticipantDeputy")
  /// Mobilisation status (B). Set when an IMT seat is "stood up" or marked unreachable.
  mobilisationStatus  MobilisationStatus    @default(UNCALLED)
  mobilisedAt         DateTime?

  /// When the participant actually first joined the live war room.
  /// Used for actual-cost computation (vs estimated cost) and for
  /// the "X arrived 12 min late" coaching finding.
  attendedFromAt  DateTime?
  /// When the participant left or the exercise closed for them.
  attendedUntilAt DateTime?
  /// Set when the participant clicks "I've read the pre-read & I'm ready".
  /// Drives the pre-flight summary's "10/12 acked" counter.
  preReadAckedAt  DateTime?
  /// Observer = sees everything read-only, no inbox / no decisions / no comms.
  /// Stakeholder = sees only the executive-summary view (status + closure + PIR).
  /// These flags don't replace exerciseRole; they layer scope on top of it.
  isObserver      Boolean   @default(false)
  isStakeholder   Boolean   @default(false)

  eventReceipts  EventReceipt[]
  injectReceipts InjectReceipt[]

  decisionsAuthored     DecisionRecord[]         @relation("DecisionAuthor")
  decisionsApproved     DecisionRecord[]         @relation("DecisionApprover")
  sitrepsAuthored       Sitrep[]
  imtMeetingsChaired    IMTMeeting[]             @relation("IMTMeetingChair")
  wellbeingChecks       ExerciseWellbeingCheck[]
  completedRunbookSteps RunbookStepExecution[]   @relation("RunbookStepCompletedBy")

  @@unique([exerciseId, userId])
}

enum MobilisationStatus {
  UNCALLED
  MOBILISED
  UNREACHABLE
  DEPUTY_STEPPED_UP
  STOOD_DOWN
}

model EventRelease {
