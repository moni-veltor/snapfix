// ─── Org-level IBS library, action items, audit log ────────────────────────

enum IBSStatus {
  DRAFT
  APPROVED
  DEPRECATED
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Organisation-level Important Business Service register. Maps to the
/// firm's formal IBS register (cf. CMORG / FCA / PRA operational-resilience
/// methodology). Per-scenario IBSs (model ImportantBusinessService) remain
/// as template fixtures; OrganizationIBS is the firm's canonical register
/// that exercises and reports refer to.
model OrganizationIBS {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  code        String // e.g. "IBS_01"
  name        String
  outcome     String? // e.g. "New and existing customers can open deposit accounts"
  description String?
  status      IBSStatus @default(DRAFT)

  // Governance
  processType        String? // e.g. "A", "B"
  processOwner       String? // free text role title
  processOwnerUserId String?
  processOwnerUser   User?     @relation("IBSProcessOwner", fields: [processOwnerUserId], references: [id], onDelete: SetNull)
  secondLineReviewer String?
  approvedAt         DateTime?
  reviewDueAt        DateTime?

  // Departmental ownership — which business unit owns this IBS end-to-end.
  ownerDepartmentId String?
  ownerDepartment   Department? @relation("IBSOwnerDepartment", fields: [ownerDepartmentId], references: [id], onDelete: SetNull)

  // Annual self-attestation chain (FCA SS1/21 expects an annual review
  // signed by 1st-line, 2nd-line, and the executive accountable.)
  attestations IBSAttestation[]

  // Methodology
  customerJourneys String[]
  productsCovered  String[]

  // Impact tolerance
  impactToleranceMin Int // Primary tolerance (minutes)
  fcaToleranceMin    Int?
  praToleranceMin    Int?
  toleranceRationale String?
  criticality        ImpactLevel @default(HIGH)

  // Legacy resource-map fields. Kept for backwards-compatibility with older
  // exercise / artefact code paths; new code reads from IBSResource[] (below).
  // Auto-fanned out into IBSResource rows on first edit via the resource map
  // editor; will be dropped in a later migration once no callers remain.
  technology   String[]
  peopleNotes  String?
  facilities   String?
  thirdParties String[]
  information  String[]
  processes    String[]

  // Structured resource map — each dependency is a row that can link to a
  // first-class entity (Vendor / TechSystem / Department), carries a
  // criticality, and groups by kind. Replaces the string-arrays above.
  resources IBSResource[]

  // Importance assessment (six standard dimensions)
  impactCustomerFinancial  ImpactLevel?
  impactVulnerableCustomer ImpactLevel?
  impactLossOfLicense      ImpactLevel?
  impactRegulatoryFine     ImpactLevel?
  impactReputational       ImpactLevel?
  impactLossOfCapital      ImpactLevel?

  // 6-box risk coverage (parallel to Scenario)
  coversPeople           Boolean @default(false)
  coversProperty         Boolean @default(false)
  coversTechnology       Boolean @default(false)
  coversDataAvailability Boolean @default(false)
  coversDataIntegrity    Boolean @default(false)
  coversThirdParty       Boolean @default(false)

  // Free-text long-form sections (markdown)
  importanceAssessmentNotes String?
  vulnerabilitiesNotes      String?
  testingNotes              String?

  createdById String?
  createdBy   User?    @relation("IBSCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exerciseLinks ExerciseIBSLink[]
  vendorLinks   VendorIBSLink[]
  runbookLinks  RunbookIBSLink[]
  scenarioLinks ImportantBusinessService[] @relation("ScenarioIBSLink")

  @@unique([orgId, code])
}

/// Three-line-of-defence attestation entry for an IBS. Each annual review
/// produces one record per line that signs off — typically FIRST_LINE
/// (process owner), SECOND_LINE (operational risk / oversight),
/// EXECUTIVE (the SMF accountable executive). Read sequentially as a
/// chain to determine the IBS's current attestation status.
enum AttestationLine {
  FIRST_LINE
  SECOND_LINE
  EXECUTIVE
}

enum AttestationStatus {
  REQUESTED
  ATTESTED
  REJECTED
}

model IBSAttestation {
  id     String            @id @default(cuid())
  ibsId  String
  ibs    OrganizationIBS   @relation(fields: [ibsId], references: [id], onDelete: Cascade)
  orgId  String // denormalised for cross-IBS queries
  cycle  String // human label for the attestation cycle e.g. "2025-Q1", "2025-FY"
  line   AttestationLine
  status AttestationStatus @default(REQUESTED)

  reviewerId String? // who attested / rejected — null for REQUESTED
  reviewer   User?   @relation("AttestationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  reviewedAt DateTime? // when the reviewer signed off / rejected
  comment    String?
  createdAt  DateTime  @default(now())

  @@unique([ibsId, cycle, line])
  @@index([ibsId])
  @@index([orgId, status])
}

/// Which org-level IBSs an exercise is testing.
model ExerciseIBSLink {
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  ibsId      String
  ibs        OrganizationIBS @relation(fields: [ibsId], references: [id], onDelete: Cascade)
  notes      String?

  @@id([exerciseId, ibsId])
}

/// Action items captured during/after an exercise. Surfaced in AAR and on
/// the org-wide /action-items tracker. Real OR programmes generate ~5–15
/// of these per exercise.
enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  WONT_FIX
  BLOCKED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ExerciseActionItem {
  id         String       @id @default(cuid())
  exerciseId String
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  orgId      String // denormalised for cross-exercise queries
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title       String
  description String?
  ownerUserId String?
  ownerUser   User?              @relation("ActionItemOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerText   String? // when owner isn't an in-system user (yet)
  dueAt       DateTime?
  priority    ActionItemPriority @default(MEDIUM)
  status      ActionItemStatus   @default(OPEN)
  evidenceUrl String?

  createdById String?
  createdBy   User?     @relation("ActionItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?
}

/// Lightweight audit log for regulator-facing accountability. Recorded at
/// the boundary of major actions (CRUD on scenarios / exercises / members /
/// IBS, role changes, invitation actions).
model AuditLogEntry {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String // e.g. "scenario.created", "exercise.started", "ibs.approved", "member.removed"
  targetType String // "scenario" | "exercise" | "ibs" | "user" | "invitation" | …
  targetId   String?
  summary    String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

/// Reusable team templates for exercises (e.g. "Incident Management",
/// "Tech Recovery"). When admins plan an exercise, they can pick from these
/// instead of re-creating teams each time.
model OrganizationTeamTemplate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  orderIdx    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
}

// ─── Incident management lifecycle ──────────────────────────────────────────

/// An Incident is a live response episode inside an Exercise. An exercise can
/// have ≥0 incidents — most have exactly one, but escalating scenarios may
/// stand up a second. State machine mirrors best practice
model Incident {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  shortCode  String // e.g. "INC-2026-05-12-A" — used in MS Teams channel naming
  title      String
  summary    String?

  status IncidentStatus @default(DECLARED)

  // Invocation
  invokedAt           DateTime?
  invokedById         String?
  invokedBy           User?     @relation("IncidentInvoker", fields: [invokedById], references: [id], onDelete: SetNull)
  invocationRationale String?

  // Stand-down (the "back down" half of "stand it up and back down")
  stoodDownAt     DateTime?
  stoodDownReason String?

  // Severity
  severity             SeverityLevel?
  severityFinancial    SeverityLevel?
  severityCustomer     SeverityLevel?
  severityData         SeverityLevel?
  severitySystems      SeverityLevel?
  severityReputational SeverityLevel?
  /// Aggravating factor — Consumer Duty PS22/3. When true, severity
  /// is promoted regardless of the financial threshold.
  consumerDutyTrigger  Boolean        @default(false)
  /// Aggravating factor — cyber/ransomware/data exfiltration default to High
  /// severity.
  cyberDefaultHigh     Boolean        @default(false)
  severityAssessedAt   DateTime?

  // Closure — five mandatory criteria
  closedAt              DateTime?
  closedById            String?
  closedBy              User?     @relation("IncidentCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closureImpactCeased   Boolean   @default(false)
  closureRegsNotified   Boolean   @default(false)
  closureLogComplete    Boolean   @default(false)
  closurePreliminaryRCA Boolean   @default(false)
  closureCRO_SignOff    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logEntries             IncidentLogEntry[]
  decisions              DecisionRecord[]
  sitreps                Sitrep[]
  imtMeetings            IMTMeeting[]
  regulatorNotifications RegulatorNotification[]
  comms                  CommunicationDraft[]
  bcpActivations         BCPActivation[]
  postIncidentReport     PostIncidentReport?
  runbookExecutions      RunbookExecution[]

  @@index([exerciseId, status])
}

enum IncidentStatus {
  DECLARED // Observed, not yet invoked
  INVOKED // CEO has stood up the IMT
  CONTAINED // Tactical containment in place
  RESOLVED // Service restored; cleanup ongoing
  STOOD_DOWN // Invoked then stood down without escalation
  CLOSED // Five closure criteria met
}

enum SeverityLevel {
  HIGH
  MEDIUM
  LOW
}

// ─── Decisions (best practice — structured incident log) ──────────────────

/// A structured Decision recorded against an Incident. Distinct from a free-text
/// IncidentLogEntry — captures authority, rationale, approver. Each
/// DecisionRecord has a corresponding IncidentLogEntry of kind DECISION which
/// is what appears in the chronological log.
model DecisionRecord {
  id         String           @id @default(cuid())
  incidentId String
  incident   Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  logEntryId String           @unique
  logEntry   IncidentLogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  decisionType DecisionType
  title        String
  rationale    String?

  authorParticipantId String?
  authorParticipant   ExerciseParticipant? @relation("DecisionAuthor", fields: [authorParticipantId], references: [id], onDelete: SetNull)
  authorUserId        String?
  authorUser          User?                @relation("DecisionAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)

  /// Roles whose approval is required by policy for this decision type.
  /// e.g. "Activate BCP" requires CEO + CRO joint.
  approverRolesRequired String[]
  approverParticipantId String?
  approverParticipant   ExerciseParticipant? @relation("DecisionApprover", fields: [approverParticipantId], references: [id], onDelete: SetNull)
  approverUserId        String?
  approverUser          User?                @relation("DecisionApproverUser", fields: [approverUserId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?

  /// Optional link to the inject that triggered this decision. Captured
  /// in the live decision form (defaulting to the most recently released
  /// inject) so the post-incident review can reconstruct cause→effect.
  triggeredByInjectId String?
  triggeredByInject   Inject? @relation("DecisionTriggerInject", fields: [triggeredByInjectId], references: [id], onDelete: SetNull)

  /// When set, this decision was logged against a custom org-defined
  /// preset (OrgDecisionType) rather than a built-in DecisionType.
  /// decisionType is still set to OTHER for backwards-compatibility.
  orgDecisionTypeId String?
  orgDecisionType   OrgDecisionType? @relation(fields: [orgDecisionTypeId], references: [id], onDelete: SetNull)

  dDayTime  String
  createdAt DateTime @default(now())
}

/// Per-org customizable decision presets. Different firms have different
/// IMT vocabulary — a bank "Halt outbound payments" vs an insurer
/// "Pause new business" — and forcing the built-in DecisionType enum on
/// every org makes the dropdown either too long or wrong. Org admins
/// add their own presets here; they appear in the live decision form
/// alongside the built-ins under an "Org-specific" optgroup.
model OrgDecisionType {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Short stable code (kebab-case) used in audit logs. Unique per org.
  code                String
  /// User-facing label shown in the dropdown.
  label               String
  /// Roles whose approval policy expects for this decision. Same shape
  /// as DecisionRecord.approverRolesRequired.
  approverRoles       String[]
  /// Optional one-line guidance shown as a tooltip on the option.
  hint                String?
  /// 4-eyes / dual-control flag. When true, the decision is surfaced
  /// with a "requires 2 approvers" chip and the approvals dock expects
  /// two independent approver-role clicks before stamping approvedAt
  /// (enforcement lands in a follow-up commit; the flag wires the UX).
  requiresDualControl Boolean  @default(false)
  archived            Boolean  @default(false)
  sortOrder           Int      @default(0)

  decisions DecisionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, code])
  @@index([orgId, archived, sortOrder])
}

/// Canonical decision templates. UI offers these as a
/// pick-list when a participant records a decision so we capture authority &
/// approver consistently.
enum DecisionType {
  INVOKE_IMT
  STAND_DOWN_IMT
  CLASSIFY_SEVERITY
  ACTIVATE_BCP
  DEACTIVATE_BCP
  NOTIFY_FCA
  NOTIFY_PRA
  NOTIFY_ICO
  CONVENE_ACTION_COMMITTEE
  APPROVE_CRISIS_COMMS
  APPROVE_REGULATOR_COMMS
  CFO_EMERGENCY_SPEND
  DRAW_CONTINGENT_LIQUIDITY
  DO_NOT_PAY_RANSOM
  INSURANCE_INVOCATION
  RECOVERY_OPTION_CHOSEN
  OTHER
}

// ─── Sitreps (initial sitrep expected from each affected BU) ────────────────

model Sitrep {
  id                 String       @id @default(cuid())
  incidentId         String
  incident           Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  businessUnit       String // e.g. "Tech Recovery", "Customer Operations"
  status             SitrepStatus
  summary            String
  issues             String?
  asks               String?
  nextUpdateDDayTime String? // when the next sitrep is expected (HH:MM)
  dDayTime           String

  authorParticipantId String?
  authorParticipant   ExerciseParticipant? @relation(fields: [authorParticipantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
}

enum SitrepStatus {
  GREEN
  AMBER
  RED
}

// ─── IMT meetings (standing agenda) ─────────────────────────────────────────

model IMTMeeting {
  id              String   @id @default(cuid())
  incidentId      String
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  meetingNumber   Int // 1, 2, 3…
  startedAtDDay   String // HH:MM on the D-Day clock
  /// Required output of every meeting.
  nextMeetingDDay String?

  // Standing agenda fields
  situation String?
  decisions String? // free-text minute of decisions (linked DecisionRecords also available)
  actions   String? // free-text minute of actions
  risks     String?

  chairParticipantId String?
  chairParticipant   ExerciseParticipant? @relation("IMTMeetingChair", fields: [chairParticipantId], references: [id], onDelete: SetNull)
  scribeUserId       String?
  scribeUser         User?                @relation("IMTMeetingScribe", fields: [scribeUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ─── Regulator notifications (countdown clocks) ─────────────────────────────

enum Regulator {
  FCA
  PRA
  ICO
  BANK_OF_ENGLAND
  OTHER
}

enum RegulatorNotificationStatus {
  PENDING
  IN_DRAFT
  AWAITING_APPROVAL
  SENT
  BREACHED // dueAt passed without being sent
  WAIVED // documented determination that notification not required
}

model RegulatorNotification {
  id                String    @id @default(cuid())
  incidentId        String
  incident          Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  regulator         Regulator
  trigger           String // e.g. "High-severity incident invoked", "Personal data breach suspected"
  /// SLA in hours from the triggering event. FCA/PRA = 4h post-invocation;
  /// ICO = 72h post-awareness; closure notification = 2 business days.
  slaHours          Int
  dueAt             DateTime
  ownerUserId       String?
  ownerUser         User?     @relation("RegulatorNotificationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerRoleTitle    String? // canonical owner role per IMP table (e.g. "CRO")
  approverRoleTitle String? // canonical approver per IMP table (e.g. "CEO")

  status          RegulatorNotificationStatus @default(PENDING)
  sentAt          DateTime?
  waiverRationale String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentId, dueAt])
}

// ─── Business Continuity activation ─────────────────────────────────────────

model BCPActivation {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  activatedAt      DateTime
  activatedByCEOId String?
  activatedByCEO   User?    @relation("BCPActivator", fields: [activatedByCEOId], references: [id], onDelete: SetNull)
  activatedByCROId String?
  activatedByCRO   User?    @relation("BCPDeactivator", fields: [activatedByCROId], references: [id], onDelete: SetNull)
  rationale        String?

  deactivatedAt     DateTime?
  deactivationNotes String?

  createdAt DateTime @default(now())
}

// ─── Critical third parties ─────────────────────────────────────────────────

model Vendor {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  /// Service the vendor provides — short label, e.g. "Core banking", "Payments".
  serviceKind  String?
  tier         VendorTier @default(TIER_2)
  /// Primary technical / commercial contact.
  contactName  String?
  contactEmail String?
  contactPhone String?
  /// Where to look for status (e.g. "status.thoughtmachine.io").
  statusUrl    String?
  notes        String?

  // ─── DORA / ICT-third-party register ───────────────────────────────
  isDoraCritical Boolean     @default(false)
  doraIctTier    VendorTier? // ICT-third-party tier; may differ from commercial tier
  hyperscaler    String? // "AWS", "GCP", "Azure", "OCI", etc. — for 4th-party concentration
  region         String? // e.g. "eu-west-2", used to detect regional concentration

  // ─── Contract ──────────────────────────────────────────────────────
  contractStartAt           DateTime?
  contractEndAt             DateTime?
  contractRenewalNoticeDays Int?
  contractAnnualValueGBP    Int?

  // ─── Assurance ─────────────────────────────────────────────────────
  /// "SOC2_TYPE_2" | "SOC2_TYPE_1" | "ISAE3402" | "ISO27001" | "NONE"
  assuranceKind     String?
  assuranceExpiryAt DateTime?

  // ─── Exit plan ─────────────────────────────────────────────────────
  exitPlanReviewedAt DateTime?
  exitPlanRTOMin     Int? // time to exit & switch in minutes
  exitPlanNotes      String?

  // 4th-party register — JSON array of { name, role, hyperscaler?, region? }
  fourthParties Json?

  // ─── FCA / PRA Material Third Party register fields ─────────────
  // All nullable — populated when the vendor crosses the materiality threshold.
  //
  // 2 Service-provider primary data
  /// Firm's internal reference for the contractual arrangement (the regulator 2.01)
  contractRef               String?
  /// Legal name of the service provider as stated in the contract (the regulator 2.02).
  /// Distinct from Vendor.name which is the day-to-day label.
  legalName                 String?
  /// Legal Entity Identifier — 20 alphanumeric chars (the regulator 2.03)
  legalEntityIdentifier     String?
  /// Firm-declared MTP flag. We don't auto-classify materiality; the firm decides.
  isMaterialThirdParty      Boolean          @default(false)
  /// the regulator 2.04: MTP outsourcing or non-outsourcing
  isOutsourcing             Boolean?
  /// the regulator 2.05: enumerated type-of-service from the regulator taxonomy
  serviceTypeTaxonomy       String?
  /// the regulator 2.06: cloud deployment model (Public/Private/Hybrid/Non-cloud)
  cloudDeployment           CloudDeployment?
  /// the regulator 2.07: short product/service description
  productServiceDescription String?
  /// the regulator 2.08: supply-chain ranking integer (intra-group = 0, direct provider = 1, etc.)
  supplyChainRanking        Int?
  /// the regulator 2.10: date service started (distinct from 2.09 contract start)
  serviceCommencedAt        DateTime?
  /// the regulator 2.12: notice period (days) the firm must give the provider on termination
  noticePeriodVendorDays    Int?
  /// the regulator 2.13: notice period (days) the provider must give the firm
  noticePeriodFirmDays      Int?
  /// the regulator 2.14: jurisdiction whose laws govern the contract
  governingLaw              String?

  // 3 Materiality + IBS link
  /// the regulator 3.01: enumerated reason the contract is material
  materialityReason           MaterialityReason?
  /// the regulator 3.02: date of most recent materiality assessment
  materialityAssessedAt       DateTime?
  /// the regulator 3.03: function category from the regulator taxonomy
  functionCategory            FunctionCategory?
  /// the regulator 3.06: whether the vendor supports a *core* element of an IBS
  supportsCoreIBSElement      Boolean?
  /// the regulator 3.07: impact tolerance — PRA Safety & Soundness
  itPRASafetySoundness        String?
  /// the regulator 3.08: impact tolerance — PRA Financial Stability
  itPRAFinancialStability     String?
  /// the regulator 3.09: impact tolerance — PRA Policyholder Protection
  itPRAPolicyholderProtection String?
  /// the regulator 3.10: impact tolerance — FCA Client Harm
  itFCAClientHarm             String?
  /// the regulator 3.11: impact tolerance — FCA Market Integrity
  itFCAMarketIntegrity        String?
  /// the regulator 3.12: impact tolerance — Bank as FMI Regulator
  itBankFMIRegulator          String?
  /// the regulator 3.13: country where data is stored at rest
  countryDataStored           String?
  /// the regulator 3.14: country where the service is delivered from
  countryServiceDeliveredFrom String?

  // 4 Compliance + governance (assessment history lives in VendorAssessment)
  /// the regulator 4.10: does the contract comply with relevant rules (FCA SS21/3, PRA SS2/21, FMI)
  compliesWithRules    ComplianceStatus?
  /// the regulator 4.11: assurance summary when compliesWithRules = NO
  assuranceSummary     String?
  /// the regulator 4.12: SMF / accountable person sign-off
  smfSignedOff         Boolean?
  /// the regulator 4.13: governance committee name when SMF sign-off = No
  governanceCommittee  String?
  /// the regulator 4.14: date governance approval recorded
  governanceApprovedAt DateTime?

  // 5 Exit + substitutability
  /// the regulator 5.01: firm's ability to substitute the service provider
  substitutability      Substitutability?
  /// the regulator 5.02: ability to reintegrate the service in-house
  reintegrationAbility  ReintegrationAbility?
  /// the regulator 5.03: impact on firm if the contract is discontinued
  impactOfDiscontinuing ImpactDiscontinuation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ibsLinks               VendorIBSLink[]
  exerciseParticipations ExerciseVendorParticipant[]
  assessments            VendorAssessment[]
  notifications          VendorMtpNotification[]
  ibsResources           IBSResource[]               @relation("IBSResourceVendor")

  @@unique([orgId, name])
  @@index([orgId, isMaterialThirdParty])
}

enum VendorTier {
  TIER_1 // Mission-critical (Thought Machine, ClearBank, AWS)
  TIER_2 // Business-critical
  TIER_3 // Business-operational
}

// ─── FCA / PRA enums ────────────────────────────────────────────────────

/// the regulator 2.06 cloud deployment model
enum CloudDeployment {
  PUBLIC
  PRIVATE
  HYBRID
  NON_CLOUD
}

/// the regulator 3.01 — reason the contract is assessed as material. The XLSX
/// taxonomy lists ~12 reasons; we mirror them but UI also accepts free-text
/// in materialityReasonNote (added with the editor).
enum MaterialityReason {
  CRITICAL_OPERATIONAL_FUNCTION
  SUPPORTS_IMPORTANT_BUSINESS_SERVICE
  CRITICAL_DATA_ACCESS
  LARGE_FINANCIAL_VALUE
  HIGH_SUBSTITUTION_COMPLEXITY
  CONCENTRATION_RISK
  CYBER_THREAT_EXPOSURE
  CROSS_BORDER_DATA_FLOW
  FOURTH_PARTY_DEPENDENCY
  REGULATED_ACTIVITY_DELEGATION
  OTHER
}

/// the regulator 3.03 — function category from the regulator taxonomy.
/// Approximation of the published list; finer-grained categories live in
/// the taxonomy constants module loaded in Commit B.
enum FunctionCategory {
  BANKING_FUNCTIONS
  PAYMENTS
  CLEARING_SETTLEMENT
  TRADING_INVESTMENT
  CUSTOMER_SERVICING
  DATA_ANALYTICS
  INFORMATION_TECHNOLOGY
  CLOUD_INFRASTRUCTURE
  CYBER_SECURITY
  HR_LEGAL_PROFESSIONAL
  OUTSOURCED_OPERATIONS
  BENCHMARK_ACTIVITIES
  OTHER
}

/// the regulator 5.01 substitutability
enum Substitutability {
  EASILY_SUBSTITUTABLE
  HIGHLY_COMPLEX_SUBSTITUTABILITY
  NOT_SUBSTITUTABLE
}

/// the regulator 5.02 ability to reintegrate the service
enum ReintegrationAbility {
  EASY
  DIFFICULT
  IMPOSSIBLE
}

/// the regulator 5.03 impact of discontinuing the arrangement
enum ImpactDiscontinuation {
  LOW
  MEDIUM
  HIGH
}

/// Outcome enum used by every assessment (risk/audit/financial/cyber) and
/// the regulator 4.02 / 4.05 / 4.07 / 4.09. Maps 1:1 to the regulator dropdown.
enum AssessmentOutcome {
  SATISFACTORY
  NON_SATISFACTORY
  ONGOING
  NOT_APPLICABLE
}

/// Which kind of assessment a VendorAssessment row represents. The latest of
/// each kind feeds the register snapshot.
enum AssessmentKind {
  RISK
  AUDIT
  FINANCIAL_DD
  CYBER_DD
}

/// the regulator 4.10 compliance with regulatory rules
enum ComplianceStatus {
  YES
  NO
  ONGOING
}

/// the regulator Submission Header 1.03 — submission type for a notification.
enum MtpSubmissionType {
  NEW_CONTRACT
  CONTRACT_CHANGE
  CONTRACT_RENEWAL
  CONTRACT_EXIT
  CONTRACT_BREACH
  MATERIAL_INCIDENT
}

/// Workflow state for a generated regulator notification.
enum MtpSubmissionStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

/// Links a Vendor to the IBSs it supports — so on a vendor outage we can show
/// "These IBSs are at risk".
model VendorIBSLink {
  vendorId String
  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ibsId    String
  ibs      OrganizationIBS @relation(fields: [ibsId], references: [id], onDelete: Cascade)
  notes    String?

  @@id([vendorId, ibsId])
}

// ─── Post-Incident Report (best practice: within 10 business days) ──────────

model PostIncidentReport {
  id         String   @id @default(cuid())
  incidentId String   @unique
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  dueAt       DateTime
  submittedAt DateTime?

  // Eight mandatory sections
  incidentSummary        String?
  timeline               String?
  rootCause              String?
  customerImpact         String?
  regulatoryImpact       String?
  controlFailures        String?
  whatWorkedWell         String?
  remediationCommitments String?

  authorUserId String?
  authorUser   User?   @relation("PIRAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Retrospective (best practice: within 5 business days post-closure) ─────

model Retrospective {
  id         String    @id @default(cuid())
  exerciseId String    @unique
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  dueAt      DateTime
  heldAt     DateTime?

  wentWell     String?
  didntGoWell  String?
  improvements String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Role-as-seat model ────────────────────────────────────────────────────
//
// Roles are an org-level concept (CEO, CRO, CTO…). An ExerciseSeat is a
// role × exercise that may be empty or claimed live. Addressing on
// events/injects matches by role abbreviation — so when someone claims the
// CRO seat in the middle of an exercise, every message addressed to "CRO"
// routes to them immediately.

model OrganizationRole {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title          String // "Chief Risk Officer"
  abbreviation   String // "CRO" — matches inject/event addressing strings
  responsibility String? // 1-line description of the seat
  isSMF          Boolean @default(false)
  isExecutive    Boolean @default(false)
  orderIdx       Int     @default(0)

  // Deputy chain — this role is the deputy of another role. If the primary's
  // seat is empty/unreachable, the deputy is expected to step up.
  deputyOfRoleId String?
  deputyOf       OrganizationRole?  @relation("RoleDeputy", fields: [deputyOfRoleId], references: [id], onDelete: SetNull)
  deputies       OrganizationRole[] @relation("RoleDeputy")

  // Standing holder — who normally sits in this seat outside an exercise.
  // Used as a suggestion when claiming seats live.
  defaultHolderId String?
  defaultHolder   User?   @relation("RoleDefaultHolder", fields: [defaultHolderId], references: [id], onDelete: SetNull)

  seats ExerciseSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, abbreviation])
  @@index([orgId])
}

enum SeatStatus {
  EMPTY // No one in the seat
  CLAIMED // Someone has taken the seat
  UNREACHABLE // The seat-holder is unreachable; deputy should step up
  DEPUTY_FILLED // A deputy from another role is covering
  STOOD_DOWN // The seat was filled but is now stood down
}

model ExerciseSeat {
  id         String           @id @default(cuid())
  exerciseId String
  exercise   Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  roleId     String
  role       OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  status       SeatStatus @default(EMPTY)
  holderUserId String?
  holderUser   User?      @relation("SeatHolder", fields: [holderUserId], references: [id], onDelete: SetNull)
  claimedAt    DateTime?
  vacatedAt    DateTime?

  /// True if this seat is filled by someone whose primary role is a deputy —
  /// useful for the UI to distinguish "deputy stepped up" from "primary".
  isDeputy Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([exerciseId, roleId])
  @@index([exerciseId, status])
}

// ─── Team chat (the back-channel real incidents need) ───────────────────────

model ChatMessage {
  id                     String   @id @default(cuid())
  exerciseId             String
  exercise               Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  authorId               String
  author                 User     @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Author's role at the moment they posted — denormalised for display so
  /// re-seating doesn't rewrite history.
  authorRoleAbbreviation String?
  body                   String
  /// dDayTime at the moment of posting — for chronological alignment in
  /// the post-exercise reconstruction.
  dDayTime               String?
  createdAt              DateTime @default(now())

  reactions Reaction[]

  @@index([exerciseId, createdAt])
}

// ─── Reactions (polymorphic on chat / log / decision / sitrep) ──────────────

enum ReactionTarget {
  CHAT
  LOG_ENTRY
  DECISION
  SITREP
}

model Reaction {
  id         String         @id @default(cuid())
  targetType ReactionTarget
  targetId   String
  userId     String
  user       User           @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  /// Emoji or short string. Kept loose so we can iterate on the picker.
  emoji      String
  createdAt  DateTime       @default(now())

  // FK to ChatMessage when targetType=CHAT (optional; makes cascade-delete clean)
  chatMessageId String?
  chatMessage   ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId, emoji])
  @@index([targetType, targetId])
}

// ─── Working-doc scratchpad (the shared Notion-style doc) ───────────────────

model ExerciseScratchpad {
  id             String   @id @default(cuid())
  exerciseId     String   @unique
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  body           String   @default("")
  lastEditedById String?
  lastEditedBy   User?    @relation("ScratchpadEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Technical recovery — system register + DR test ledger ──────────────────

enum TechSystemKind {
  APPLICATION
  INFRASTRUCTURE
  DATABASE
  NETWORK
  AUTH
  OBSERVABILITY
  OTHER
}

enum TechSystemTier {
  CRITICAL // RTO < 1h, RPO measured in minutes
  ESSENTIAL // RTO < 4h
  IMPORTANT // RTO < 24h
  ROUTINE // best effort
}

enum TechFailoverKind {
  ACTIVE_ACTIVE
  ACTIVE_PASSIVE
  WARM_STANDBY
  COLD_RESTORE
  NONE
}

enum DRTestOutcome {
  PASS
  PARTIAL
  FAIL
}

/// A technical system that supports one or more IBSs. The recovery posture
/// for each — RTO/RPO/MTPD, failover topology, backup story — lives here.
model TechSystem {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String
  kind        TechSystemKind @default(APPLICATION)
  tier        TechSystemTier @default(IMPORTANT)
  description String?
  owner       String?

  // Objectives
  rtoMin  Int? // recovery time objective (minutes)
  rpoMin  Int? // recovery point objective (minutes)
  mtpdMin Int? // max tolerable period of disruption (minutes)

  // Failover topology
  primaryRegion  String?
  failoverRegion String?
  failoverKind   TechFailoverKind @default(NONE)

  // Backup posture
  backupFrequency       String? // free text e.g. "continuous", "hourly", "daily"
  backupRetentionDays   Int?
  lastBackupValidatedAt DateTime?

  // DR testing schedule + cadence. nextDrTestDueAt drives the "due-soon"
  // dashboard widget; drTestCadenceMonths is the firm-policy interval
  // (e.g. tier-1 systems tested every 3 months).
  drTestCadenceMonths Int?
  nextDrTestDueAt     DateTime?

  notes String?

  drTests      DRTest[]
  ibsResources IBSResource[] @relation("IBSResourceTechSystem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

/// A DR-test result against a TechSystem. Used to derive "last tested" and
/// "actual RTO vs target" — the ledger the regulator asks for.
model DRTest {
  id       String     @id @default(cuid())
  systemId String
  system   TechSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  testedAt     DateTime
  outcome      DRTestOutcome @default(PASS)
  rtoActualMin Int?
  rpoActualMin Int?
  participants String? // free text who ran the test
  notes        String?

  // Tech-lead sign-off — the named accountable owner attests the result is
  // valid and any gap-to-target has been recorded for remediation.
  attestedById String?
  attestedBy   User?     @relation("DRTestAttester", fields: [attestedById], references: [id], onDelete: SetNull)
  attestedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([systemId])
}

// ─── Plan-an-Exercise wizard models ──────────────────────────────────────────

/// Chained scenarios on a single exercise. Lets a realistic exercise compose
/// multiple scenarios that fire concurrently or in sequence
/// (e.g. cyber breach → triggers vendor escalation at +90m → triggers BCP
/// walkthrough at +180m). Exercise.scenarioId remains the *primary* scenario
/// for backwards compatibility; this table adds the others.
model ExerciseScenarioLink {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])
  /// 0 = primary (mirror of Exercise.scenarioId); 1+ = chained in order
  sequence   Int
  /// Offset in minutes from exercise D-Day start. 0 = fires concurrently;
  /// > 0 = fires later in the timeline.
  offsetMin  Int      @default(0)
  /// Optional facilitator label shown in the timeline so participants
  /// understand the source ("this inject is from the vendor-loss
  /// scenario, not the cyber one").
  label      String?

  createdAt DateTime @default(now())

  @@unique([exerciseId, sequence])
  @@index([exerciseId])
}

/// External vendor / third-party representative invited to participate in an
/// exercise. Scoped, time-bounded access via signed token URL. Every page
/// view logged for evidence.
model ExerciseVendorParticipant {
  id             String                 @id @default(cuid())
  exerciseId     String
  exercise       Exercise               @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contactName    String
  contactEmail   String
  /// One-time-use signed URL token used to access the exercise without
  /// requiring a SnapFix login. Expires at tokenExpiresAt.
  accessToken    String                 @unique
  tokenExpiresAt DateTime
  scope          VendorParticipantScope
  invitedAt      DateTime               @default(now())
  joinedAt       DateTime?
  leftAt         DateTime?
  /// Number of audited reads — incremented per page view by the vendor.
  readCount      Int                    @default(0)

  @@index([exerciseId])
  @@index([vendorId])
}

/// Per-exercise inject customization. Sparse table — only rows for injects
/// added, hidden, or retimed for this specific exercise. Scenario.injects
/// remains the canonical template; this layers on overrides.
model ExerciseInjectOverride {
  id              String      @id @default(cuid())
  exerciseId      String
  exercise        Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// Null = brand-new inject custom to this exercise.
  /// Non-null = override of the scenario inject with this id.
  injectId        String?
  inject          Inject?     @relation(fields: [injectId], references: [id], onDelete: Cascade)
  /// When true, suppress the underlying scenario inject from this exercise's run.
  hidden          Boolean     @default(false)
  /// Override the scenario's scheduledTime (HH:MM on D-Day).
  scheduledTime   String?
  // ── Custom-inject fields (mirror Inject when injectId is null) ────────────
  summary         String?
  description     String?
  kind            InjectKind?
  senderRoleTitle String?
  toRoleTitles    String[]
  ccRoleTitles    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([exerciseId])
  @@index([injectId])
}

/// Sign-off captured before a high-cost / high-classification / regulator-mode
/// exercise can transition from PLANNING to READY. Append-only audit record.
model ExerciseApproval {
  id                   String                 @id @default(cuid())
  exerciseId           String
  exercise             Exercise               @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  approverUserId       String
  approverUser         User                   @relation("ExerciseApprover", fields: [approverUserId], references: [id], onDelete: Cascade)
  /// Snapshot of approver's name + role at the time, so later renames
  /// don't rewrite the evidence trail.
  approverNameSnapshot String
  approverRoleSnapshot String?
  status               ExerciseApprovalStatus @default(PENDING)
  comment              String?
  signedAt             DateTime?
  createdAt            DateTime               @default(now())

  @@index([exerciseId])
}

/// 15-minute structured "hot-wash" captured immediately at end of exercise,
/// before the team disperses. Distinct from the formal Retrospective (5 days
/// later) and the AfterActionReport (publish-grade summary).
model ExerciseHotWash {
  id               String   @id @default(cuid())
  exerciseId       String   @unique
  exercise         Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  heldAt           DateTime @default(now())
  /// Quick summary written live by the facilitator while the team is still in the room.
  summary          String?
  /// The 1-3 things that hurt most during this run.
  immediateGaps    String?
  /// The 1-3 things that worked surprisingly well.
  immediateWins    String?
  /// Raw bullet-list of next-actions (later promoted to ExerciseActionItem).
  nextActionsRaw   String?
  capturedByUserId String?

  createdAt DateTime @default(now())
}

/// Anonymous one-question wellbeing check shown to participants at the end
/// of an exercise. Aggregates feed a programme-level burnout indicator.
model ExerciseWellbeingCheck {
  id            String               @id @default(cuid())
  exerciseId    String
  exercise      Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// Nullable for anonymous submission (default). When non-null, identifies
  /// the participant who chose to attribute their response.
  participantId String?
  participant   ExerciseParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  /// 1 = energising; 5 = severely draining.
  stressLevel   Int
  note          String?
  createdAt     DateTime             @default(now())

  @@index([exerciseId])
}

/// Audit row written every time a user reads a CONFIDENTIAL or SECRET
/// exercise. Captured separately from the general AuditLogEntry so the
/// insider list / regulator can see exactly who saw what when.
model ExerciseClassifiedReader {
  id           String   @id @default(cuid())
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  readerUserId String
  readerUser   User     @relation("ClassifiedReadReader", fields: [readerUserId], references: [id], onDelete: Cascade)
  /// What surface they accessed (e.g. "exercise.overview", "exercise.injects",
  /// "exercise.evidence-pack"). Free-text, indexed for query.
  surface      String
  /// IP captured from request headers, best-effort. Null when unavailable.
  ipAddress    String?
  /// User-agent captured from request headers, best-effort.
  userAgent    String?
  readAt       DateTime @default(now())

  @@index([exerciseId, readAt])
  @@index([readerUserId, readAt])
}

/// Tamper-evident audit hash chain. Each entry includes the SHA-256 of the
/// previous entry, so any retroactive edit is detectable. Written only when
/// the exercise is in regulator-evidence mode; otherwise standard AuditLogEntry
/// is sufficient.
model ExerciseAuditHashEntry {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sequence   Int
  /// SHA-256 hex of: prevHash || canonical(payload) || timestamp.
  hash       String
  /// SHA-256 hex of the previous entry, or 64 zero-chars for sequence 0.
  prevHash   String
  /// Canonical JSON payload of the audited event.
  payload    Json
  /// Monotonic timestamp; used in hash input.
  occurredAt DateTime @default(now())

  @@unique([exerciseId, sequence])
  @@index([exerciseId])
}

// ─── FCA / PRA vendor models ────────────────────────────────────────────

/// Append-only history of vendor assessments. the regulator expects four separate
/// assessment streams (risk / audit / financial DD / cyber DD); the latest
/// row of each kind populates the register submission.
model VendorAssessment {
  id               String            @id @default(cuid())
  vendorId         String
  vendor           Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kind             AssessmentKind
  /// the regulator 4.01 / 4.04 / 4.06 / 4.08 — date of this assessment
  assessedAt       DateTime
  /// the regulator 4.02 / 4.05 / 4.07 / 4.09 — outcome
  outcome          AssessmentOutcome
  /// the regulator 4.03 — commentary (only required when outcome != Satisfactory)
  commentary       String?
  /// User who recorded this assessment, for audit trail
  recordedByUserId String?
  recordedByUser   User?             @relation("VendorAssessmentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([vendorId, kind, assessedAt])
}

/// A single regulator notification event. One row per submission, immutable
/// once SUBMITTED. The XLSX file generated for the submission is uploaded
/// to Vercel Blob and the URL stored here.
model VendorMtpNotification {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// the regulator 1.03 — what kind of event is being notified
  submissionType   MtpSubmissionType
  /// the regulator 1.02 — auto-incremented per (firm, vendor) so resubmissions can
  /// be tracked. Computed at create-time.
  submissionId     Int
  /// the regulator 1.01 — when the notification was prepared
  reportingDate    DateTime
  /// the regulator 1.07 — short narrative of changes when type=CONTRACT_RENEWAL
  changeNarrative  String?
  /// Free-text reason / context the firm captures alongside the XLSX
  notificationNote String?

  status         MtpSubmissionStatus @default(DRAFT)
  /// When the firm actually files the notification with the regulator.
  submittedAt    DateTime?
  /// Optional regulator acknowledgement reference once they confirm receipt.
  acknowledgedAt DateTime?
  ackReference   String?

  /// Vercel Blob URL of the generated XLSX in the official template format.
  xlsxBlobUrl  String?
  xlsxBlobPath String?

  createdByUserId String?
  createdByUser   User?   @relation("MtpNotificationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, submissionId])
  @@index([vendorId, createdAt])
}

/// Annual snapshot of every Material Third Party. the regulator expects firms to
/// file the Annual MTP Register once a year. Snapshots are immutable; later
/// changes go into next year's snapshot or as notifications.
model VendorRegisterSnapshot {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// the regulator 1.01 — as-of date the snapshot represents
  reportingDate DateTime
  /// the regulator 1.02 — auto-incremented per org
  submissionId  Int

  /// JSON array of { vendorId, snapshotData } — the exact frozen view of
  /// each MTP at the moment of snapshot. Keeps the regulator-filed contents
  /// reproducible even if the Vendor row changes later.
  vendorSnapshots Json

  /// Vercel Blob URL of the generated XLSX in the official register format.
  xlsxBlobUrl  String?
  xlsxBlobPath String?

  createdByUserId String?
  createdByUser   User?   @relation("RegisterSnapshotCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([orgId, submissionId])
  @@index([orgId, reportingDate])
}

// ─── Structured IBS resource map ─────────────────────────────────────────────

enum IBSResourceKind {
  TECHNOLOGY
  THIRD_PARTY
  INFORMATION
  PROCESS
  PEOPLE
  FACILITY
}

enum IBSResourceCriticality {
  CRITICAL
  IMPORTANT
  SUPPORTING
}

/// One dependency this IBS relies on. Replaces the legacy 6-string-array
/// fields. Each row carries a kind, a criticality, and optionally links to a
/// first-class entity (Vendor / TechSystem / Department). `label` is always
/// set — used as the display name + the shared-dependency join key across
/// IBSs (so "AWS" linked to a vendor row is matchable with another IBS's
/// "AWS" string).
model IBSResource {
  id    String          @id @default(cuid())
  ibsId String
  ibs   OrganizationIBS @relation(fields: [ibsId], references: [id], onDelete: Cascade)

  kind        IBSResourceKind
  label       String
  criticality IBSResourceCriticality @default(SUPPORTING)

  // Optional entity links. At most one of vendorId / techSystemId /
  // departmentId is set on any given row. When linked, label can be derived
  // from the entity's name.
  vendorId     String?
  vendor       Vendor?     @relation("IBSResourceVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  techSystemId String?
  techSystem   TechSystem? @relation("IBSResourceTechSystem", fields: [techSystemId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation("IBSResourceDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  /// Optional free-text annotation visible in the editor's expanded view.
  note     String?
  /// Ordering within (ibsId, kind) so the UI stays stable across edits.
  orderIdx Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ibsId, kind, orderIdx])
  /// Lowercased label index for cross-IBS shared-dependency lookup.
  @@index([label])
}

// ─── Runbooks ───────────────────────────────────────────────────────────────
//
// A runbook is structured workflow for handling a class of incident — the
// step-by-step playbook the IMT walks when a cyber incident, vendor outage,
// or BCP activation lands. Steps are typed (ACTION / DECISION / NOTIFICATION
// / COMMS / CHECKPOINT) so the live workspace can drive the right form when
// a step is started. Runbooks ship as a library and are cloned + customised
// per org, the same pattern as Scenarios.
//
// Live activation, step execution snapshots, and the decision/comms/notif
// wiring all land in later commits — the schema below is the registry +
// builder + linking layer.

enum RunbookCategory {
  CYBER
  RANSOMWARE
  CLOUD_REGION_OUTAGE
  VENDOR_FAILURE
  BCP_ACTIVATION
  DATA_INCIDENT
  PEOPLE_DISRUPTION
  REGULATORY_NOTIFICATION
  OTHER
}

enum RunbookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Step kind drives which form the live workspace opens when this step is
/// started. ACTION = free-text completion; DECISION = links to DecisionRecord;
/// NOTIFICATION = creates a RegulatorNotification with SLA; COMMS = drafts a
/// CommunicationDraft from a template; CHECKPOINT = pause-and-verify gate.
enum RunbookStepKind {
  ACTION
  DECISION
  NOTIFICATION
  COMMS
  CHECKPOINT
}

model Runbook {
  id    String        @id @default(cuid())
  /// Nullable for library templates (orgId = null + isTemplate = true).
  /// Cloned into an org sets orgId and unsets isTemplate.
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    RunbookCategory @default(OTHER)

  /// Accountable role title (e.g. "CRO", "CTO"). Free text so it matches the
  /// firm's role vocabulary rather than a fixed enum.
  ownerRoleTitle String?

  /// Bumps on publishRunbookAction. RunbookExecution (later commit) snapshots
  /// the runbook at this version so historical evidence stays reproducible.
  version     Int           @default(1)
  publishedAt DateTime?
  status      RunbookStatus @default(DRAFT)

  /// Library template marker — same pattern as Scenario.isTemplate.
  isTemplate       Boolean   @default(false)
  templateOriginId String?
  templateOrigin   Runbook?  @relation("RunbookTemplate", fields: [templateOriginId], references: [id], onDelete: SetNull)
  clones           Runbook[] @relation("RunbookTemplate")

  archivedAt DateTime?

  /// Freshness stamp. Bumped by markRunbookReviewedAction — the pre-flight
  /// flags a runbook as stale when this is null or older than the org's
  /// review cadence (default 180d). Independent of publishedAt so a
  /// runbook can be re-reviewed without forcing a version bump.
  lastReviewedAt   DateTime?
  lastReviewedById String?
  lastReviewedBy   User?     @relation("RunbookReviewer", fields: [lastReviewedById], references: [id], onDelete: SetNull)

  /// Drill timestamp. Stamped when a facilitator clicks "Drill this runbook"
  /// — it spins up a lightweight WALKTHROUGH exercise whose scenario is
  /// linked back to this runbook. Surfaced as a chip on the card + detail
  /// page so it's visible whether the team has actually walked through it.
  lastDrilledAt DateTime?

  steps         RunbookStep[]
  ibsLinks      RunbookIBSLink[]
  scenarioLinks RunbookScenarioLink[]
  trigger       RunbookTriggerCondition?
  executions    RunbookExecution[]
  escalatesTo   RunbookEscalation[]      @relation("RunbookEscalationSource")
  escalatedFrom RunbookEscalation[]      @relation("RunbookEscalationTarget")

  createdById String?
  createdBy   User?    @relation("RunbookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, category])
  @@index([isTemplate])
}

model RunbookStep {
  id        String  @id @default(cuid())
  runbookId String
  runbook   Runbook @relation(fields: [runbookId], references: [id], onDelete: Cascade)

  /// Ordering within the runbook. Sparse-integer style — reorders rewrite
  /// the column rather than inserting fractional positions.
  orderIdx Int

  title       String
  description String? // markdown
  kind        RunbookStepKind @default(ACTION)

  /// Role title that owns this step (e.g. "CTO", "Head of Comms"). Used to
  /// route the step into a participant's queue in the live workspace.
  ownerRoleTitle String?

  /// Expected time to complete in minutes — drives the pacing score and the
  /// ETA chip on the COO dashboard.
  estimatedMin Int?

  /// Acceptance criteria — the visible "done means…" prompt shown above the
  /// completion button.
  successCriteria String?

  /// DAG semantics without a graph editor. blocksOrders lists the orderIdx
  /// values that must reach COMPLETE (or SKIPPED with reason) before this
  /// step becomes startable. Validated against sibling steps server-side.
  blocksOrders Int[]

  /// DECISION-specific. References either a built-in DecisionType (free
  /// string, e.g. "ACTIVATE_BCP") or an OrgDecisionType by id.
  decisionTypeCode  String?
  orgDecisionTypeId String?

  /// NOTIFICATION-specific. JSON shape: { regulator: "FCA"|"PRA"|"ICO"|...,
  /// slaHours: number, trigger: "POST_INVOCATION"|"POST_AWARENESS" }.
  regulatorTrigger Json?

  /// COMMS-specific. JSON shape: { stakeholder, subject, bodyTemplate }.
  /// bodyTemplate supports {{incident.title}} / {{incident.severity}} /
  /// {{org.name}} placeholders rendered at activation time.
  commsTemplate Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runbookId, orderIdx])
  @@index([runbookId])
}

/// Which IBSs this runbook protects. Surfaced on the IBS detail page as
/// "Runbooks that cover this IBS" so an IBS owner can find their playbook
/// without digging.
model RunbookIBSLink {
  runbookId String
  runbook   Runbook         @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  ibsId     String
  ibs       OrganizationIBS @relation(fields: [ibsId], references: [id], onDelete: Cascade)

  @@id([runbookId, ibsId])
}

/// Which scenarios test this runbook. Lets the planner see "this scenario
/// exercises 2 runbooks — last rehearsed N days ago" in the pre-flight.
model RunbookScenarioLink {
  runbookId  String
  runbook    Runbook  @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@id([runbookId, scenarioId])
}

/// Auto-activation trigger. A runbook fires when (severityAtLeast is null OR
/// incident.severity >= severityAtLeast) AND (scenarioCategoryEquals is null
/// OR scenario.category equals it). One row per runbook (or none — manual
/// activation only).
model RunbookTriggerCondition {
  runbookId String  @id
  runbook   Runbook @relation(fields: [runbookId], references: [id], onDelete: Cascade)

  /// Incident severity threshold ("LOW"|"MEDIUM"|"HIGH"|"CRITICAL").
  /// String rather than enum so the live activation logic can compare
  /// against the IncidentSeverity column without an enum round-trip.
  severityAtLeast        String?
  scenarioCategoryEquals String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Escalation chain — when this source runbook is activated, the target
/// runbook is the natural downstream playbook to activate next (e.g.
/// "RANSOMWARE → FCA material incident notification"). The chain is
/// data-driven so /runbooks/[id] can render "this triggers…" + "this is
/// triggered by…" panels, and the activation flow can prompt the
/// facilitator to fire downstream runbooks rather than relying on
/// implicit knowledge in the IMT chair's head.
model RunbookEscalation {
  id              String  @id @default(cuid())
  sourceRunbookId String
  source          Runbook @relation("RunbookEscalationSource", fields: [sourceRunbookId], references: [id], onDelete: Cascade)
  targetRunbookId String
  target          Runbook @relation("RunbookEscalationTarget", fields: [targetRunbookId], references: [id], onDelete: Cascade)

  /// Optional severity gate. When set, the escalation only fires once
  /// the incident reaches this severity ("LOW"|"MEDIUM"|"HIGH"|"CRITICAL").
  /// Null = always escalate when the source is activated.
  severityAtLeast String?
  /// Optional short reason ("data exfiltration triggers ICO 72h").
  rationale       String?
  /// Sparse-integer ordering so escalations render in a stable sequence
  /// when a single source has multiple downstream playbooks.
  orderIdx        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceRunbookId, targetRunbookId])
  @@index([targetRunbookId])
}

// ─── Runbook execution (live activation + step progress) ───────────────────
//
// One RunbookExecution per (incident × runbook). Snapshots the runbook +
// every step into runbookJson at activation time so the version-of-record
// stays reproducible even if the runbook is later edited or archived.
//
// Step state is tracked separately on RunbookStepExecution rows — the same
// row also holds the linkedDecisionId / linkedNotificationId / linkedCommsId
// pointers that Commit D will populate when a step's owner completes the
// associated form.

enum RunbookExecutionStatus {
  ACTIVE
  COMPLETE
  ABANDONED
}

enum RunbookExecutionTrigger {
  AUTO
  MANUAL
}

enum RunbookStepExecutionStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  SKIPPED
  BLOCKED
}

model RunbookExecution {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  runbookId  String
  runbook    Runbook  @relation(fields: [runbookId], references: [id], onDelete: Cascade)

  /// Frozen JSON snapshot of the runbook at activation time. Shape mirrors
  /// the Runbook + RunbookStep models so post-mortem can read the version
  /// that ran without joining back to the live records.
  runbookJson Json

  status            RunbookExecutionStatus  @default(ACTIVE)
  activatedBy       RunbookExecutionTrigger @default(AUTO)
  activatedByUserId String?
  activatedByUser   User?                   @relation("RunbookExecutionActivator", fields: [activatedByUserId], references: [id], onDelete: SetNull)

  /// Snapshot at activation time so future severity changes don't void the
  /// trigger reason. Helps the post-mortem read "activated because…".
  activationReason String?

  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  abandonedReason String?

  stepExecutions RunbookStepExecution[]

  @@unique([incidentId, runbookId])
  @@index([incidentId])
}

model RunbookStepExecution {
  id          String           @id @default(cuid())
  executionId String
  execution   RunbookExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  /// orderIdx of the step inside the frozen runbookJson. Combined with
  /// executionId, this is the stable key — we don't FK back to RunbookStep
  /// because that row may change after activation.
  stepOrderIdx Int

  status RunbookStepExecutionStatus @default(PENDING)

  startedAt                DateTime?
  completedAt              DateTime?
  completedByParticipantId String?
  completedByParticipant   ExerciseParticipant? @relation("RunbookStepCompletedBy", fields: [completedByParticipantId], references: [id], onDelete: SetNull)
  notes                    String?

  /// Reverse links to the artefacts produced by this step. Populated in
  /// Commit D — completing a DECISION step writes linkedDecisionId, a
  /// NOTIFICATION step writes linkedNotificationId, a COMMS step
  /// writes linkedCommsId.
  linkedDecisionId     String?
  linkedNotificationId String?
  linkedCommsId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([executionId, stepOrderIdx])
  @@index([executionId, status])
}

// ─── Achievements — sticky unlock history ──────────────────────────────────
//
// One row per (scope × achievement) the first time the rule fires. The
// engine treats L1–L3 unlocks as sticky: even if the underlying state
// regresses, the row stays and the badge keeps showing as earned. L4–L5
// re-check live state on every read.
//
// scope = "org" for org-wide unlocks, "user:{userId}" for personal — keeps
// the unique constraint clean since Postgres treats null in unique tuples
// as distinct (so a plain nullable userId wouldn't work).

model AchievementUnlock {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Set when the achievement is personal. Null for org-wide unlocks.
  userId String?
  user   User?   @relation("AchievementUnlockUser", fields: [userId], references: [id], onDelete: SetNull)

  /// Synthetic key: "org" or "user:{userId}". Lets us index uniquely.
  scope         String
  achievementId String
  /// Maturity level (1..5) for the rule that unlocked.
  level         Int
  /// XP awarded at unlock time. Tier weights live in the engine; we store
  /// the amount so historic XP doesn't shift if weights change.
  xpAwarded     Int

  unlockedAt DateTime @default(now())

  @@unique([orgId, scope, achievementId])
  @@index([orgId, unlockedAt])
  @@index([orgId, level])
}

// ────────────────────────────────────────────────────────────────────────────
// Annual operational-resilience self-attestation
// ────────────────────────────────────────────────────────────────────────────
//
// The PRA (mirrored by FCA SYSC 15A) expects every in-scope firm to produce,
// sign and retain an annual self-assessment stating it is operating within
// impact tolerances for every IBS — or has a credible plan to get there.
// The artefact must be reproducible at any supervisory visit and retained
// for six years; material changes during the year may trigger re-attestation.
//
// These models layer ON TOP of the per-IBS three-line `IBSAttestation` chain:
// the per-IBS layer captures granular sign-off for one service; this layer
// captures the firm-wide annual roll-up signed by the named SMF.

enum OrgResilienceAttestationStatus {
  DRAFT
  UNDER_REVIEW
  ATTESTED
  SUPERSEDED
}

enum OrgResilienceMaterialChangeKind {
  IBS_ADDED
  IBS_REMOVED
  TOLERANCE_CHANGED
  VENDOR_CRITICALITY_CHANGED
  RESOURCE_MAP_CHANGED
  NEW_REGULATORY_REQ
  MATERIAL_INCIDENT
  OTHER
}

enum OrgResilienceMaterialChangeOutcome {
  PENDING
  ACKNOWLEDGED
  TRIGGERED_REATTESTATION
  NO_ACTION
}

/// One annual self-attestation cycle. The firm-wide artefact that rolls up
/// IBS register + tolerances + 12 months of testing + action items + gap
/// analysis + investment plan, signed by 1st-line, 2nd-line and the named
/// SMF (with optional board ratification). Hard-retained for six years
/// from openedAt via retainUntilAt.
model OrgResilienceAttestation {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Cycle year (e.g. 2026). Pairs with cycleLabel for free-text override
  /// (e.g. "FY2026" or "H1 2026"). Used in the dashboard list.
  cycleYear  Int
  cycleLabel String?

  status OrgResilienceAttestationStatus @default(DRAFT)

  openedAt   DateTime @default(now())
  openedById String?
  openedBy   User?    @relation("ResilienceAttestationOpener", fields: [openedById], references: [id], onDelete: SetNull)

  // Three-line sign-off chain. Each line records who, when, and any
  // commentary attached to the signature. Lines must be completed in
  // order: first → second → executive. Board ratification is captured
  // as a free-text reference (minute / meeting date) — the platform
  // doesn't model board membership.
  firstLineSignedAt   DateTime?
  firstLineSignedById String?
  firstLineSignedBy   User?     @relation("ResilienceAttestationFirstLine", fields: [firstLineSignedById], references: [id], onDelete: SetNull)
  firstLineNotes      String?

  secondLineSignedAt   DateTime?
  secondLineSignedById String?
  secondLineSignedBy   User?     @relation("ResilienceAttestationSecondLine", fields: [secondLineSignedById], references: [id], onDelete: SetNull)
  secondLineNotes      String?

  executiveSignedAt   DateTime?
  executiveSignedById String?
  executiveSignedBy   User?     @relation("ResilienceAttestationExecutive", fields: [executiveSignedById], references: [id], onDelete: SetNull)
  executiveNotes      String?

  boardApprovedAt DateTime?
  boardCommittee  String?
  boardMinuteRef  String?

  /// Frozen rollup of the firm's resilience posture at sign-off — every
  /// approved IBS, attestation chain, resource map, vendor links, last
  /// 12 months of exercise history, open action items. Built by
  /// buildResilienceSnapshot(orgId, cycleId).
  snapshotJson Json?

  /// Structured gap analysis. Shape: [{ ibsId, gap, remediation, ownerId,
  /// dueDate, costGBP }]. Hand-curated narrative — action items can be
  /// surfaced as candidates but the firm writes the gap statement.
  gapsJson Json?

  /// Structured investment plan. Shape: [{ item, costGBP, ownerId,
  /// plannedDate, status }].
  investmentPlanJson Json?

  /// Markdown executive summary that fronts the generated pack.
  executiveSummary String?

  /// Vercel Blob URL of the generated XLSX/PDF pack.
  blobUrl  String?
  blobPath String?

  /// Set when a later cycle supersedes this one (e.g. mid-year re-attestation
  /// after a material change). Read-only signal — the prior cycle stays
  /// retrievable for six years.
  supersededByCycleId String?

  /// Hard floor on deletion. Computed as openedAt + 6 years at creation;
  /// the cascade-delete path checks this before permitting any removal.
  retainUntilAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialChanges OrgResilienceMaterialChange[]
  hashChain       OrgResilienceAttestationHashEntry[]

  @@unique([orgId, cycleYear])
  @@index([orgId, status])
  @@index([orgId, openedAt])
}

/// Material change declared against (or capable of triggering) an annual
/// attestation cycle. Logged when something happens during the year that
/// could undermine the firm's standing assertion — a new critical vendor,
/// a tolerance change, a notable incident. Each entry is reviewed and
/// either acknowledged (no action), triggers a re-attestation, or is
/// flagged as no-action.
model OrgResilienceMaterialChange {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Optional link to the cycle this change affects. Null when the change
  /// is declared between cycles or before the next cycle is opened.
  attestationCycleId String?
  attestationCycle   OrgResilienceAttestation? @relation(fields: [attestationCycleId], references: [id], onDelete: SetNull)

  kind        OrgResilienceMaterialChangeKind
  description String

  /// IDs of OrganizationIBS rows this change impacts. Empty array =
  /// firm-wide change (e.g. a new regulatory requirement).
  impactedIbsIds String[]

  declaredAt   DateTime @default(now())
  declaredById String?
  declaredBy   User?    @relation("ResilienceMaterialChangeDeclarer", fields: [declaredById], references: [id], onDelete: SetNull)

  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?                              @relation("ResilienceMaterialChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewOutcome OrgResilienceMaterialChangeOutcome @default(PENDING)
  reviewNotes   String?

  /// Reference to the audit log entry that captured the declaration.
  auditEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, declaredAt])
  @@index([orgId, reviewOutcome])
  @@index([attestationCycleId])
}

/// Hash-chained record of attestation sign-off events. Mirrors the
/// ExerciseAuditHashEntry pattern: each row's hash is SHA-256 of
/// prevHash || canonical(payload) || timestamp, with sequence 0 starting
/// from 64 zero-chars. Lets a supervisor verify the chain offline and
/// detect tampering.
model OrgResilienceAttestationHashEntry {
  id            String                   @id @default(cuid())
  attestationId String
  attestation   OrgResilienceAttestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)

  sequence   Int
  hash       String
  prevHash   String
  payload    Json
  occurredAt DateTime @default(now())

  @@unique([attestationId, sequence])
  @@index([attestationId])
}
